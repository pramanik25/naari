<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.SafetyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/emergency_primary</item>
        <item name="colorOnPrimary">@color/surface_primary</item>
        <item name="colorPrimaryContainer">@color/emergency_tertiary</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/trust_primary</item>
        <item name="colorOnSecondary">@color/surface_primary</item>
        <item name="android:statusBarColor">@color/emergency_primary</item>
        <item name="android:navigationBarColor">@color/surface_primary</item>
        <item name="materialButtonStyle">@style/Widget.SafetyApp.Button</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SafetyApp.TitleMedium</item>
    </style>

    <style name="Widget.SafetyApp.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SafetyApp.MediumComponent</item>
        <item name="android:textColor">@color/surface_primary</item>
    </style>

    <style name="TextAppearance.SafetyApp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineHeight">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.SafetyApp.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>