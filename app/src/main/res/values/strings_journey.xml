    <string name="jr_ss_section_sos">SOS behaviour</string>
    <string name="jr_ss_silent">Silent SOS</string>
    <string name="jr_ss_silent_sub">No siren, screen or flashlight. Contacts are alerted and evidence is recorded quietly.</string>
    <string name="jr_ss_strobe">Flashlight strobe</string>
    <string name="jr_ss_strobe_sub">Flash the torch during a loud SOS to draw attention.</string>
