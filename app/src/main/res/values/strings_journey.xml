    <string name="jr_ss_video_confirm_body">Video drains the battery faster and uses a lot of mobile data. Photos and audio are usually enough.</string>
    <string name="jr_ss_mobile">Upload on mobile data</string>
    <string name="jr_ss_mobile_sub">Send evidence right away, not only on Wi-Fi.</string>

