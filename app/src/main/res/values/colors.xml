<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Naari Kavach — "Midnight Rose" design tokens (premium/elite pass).
         Light ("Ivory Pearl") and dark ("Onyx Rose") palettes: a warm,
         boutique-security neutral base, a rose signature accent for SOS,
         violet for secondary actions and a champagne gold reserved for
         premium accents (eyebrows, hairlines, medallions).
         Use the ns_* tokens in new code. Legacy names at the bottom
         are aliases kept so older references still resolve.
         ============================================================ -->

    <!-- Surfaces (elevation increases downwards) — "Ivory Pearl" light palette.
         The dark "Onyx Rose" values live in values-night/colors.xml. -->
    <color name="ns_bg">#FFFAF8F4</color>
    <color name="ns_bg_top">#FFF2E9DC</color>
    <color name="ns_surface">#FFFFFFFF</color>
    <color name="ns_surface_high">#FFF5F1E9</color>
    <color name="ns_surface_highest">#FFEBE3D4</color>
    <color name="ns_stroke">#FFE8E0D0</color>
    <color name="ns_stroke_soft">#14000000</color>
    <color name="ns_scrim">#E6FAF8F4</color>

    <!-- Text -->
    <color name="ns_text">#FF1B1720</color>
    <color name="ns_text_muted">#FF5B5568</color>
    <color name="ns_text_faint">#FF8B8598</color>

    <!-- Signature rose (SOS / primary) -->
    <color name="ns_rose">#FFE8336B</color>
    <color name="ns_rose_deep">#FFC2185B</color>
    <color name="ns_rose_dark">#FF8E0E3E</color>
    <color name="ns_rose_container">#1FE8336B</color>
    <color name="ns_on_rose">#FFFFFFFF</color>

    <!-- Violet (secondary) -->
    <color name="ns_violet">#FF6A5AE0</color>
    <color name="ns_violet_deep">#FF4B3BC4</color>
    <color name="ns_violet_container">#1F6A5AE0</color>

    <!-- Champagne gold (premium accent; deeper on light for legible text) -->
    <color name="ns_gold">#FF96631A</color>
    <color name="ns_gold_container">#1F96631A</color>
    <!-- Bright gold for small standalone accents (medallion rims, dividers, icons). -->
    <color name="ns_gold_bright">#FFB9822E</color>
    <!-- Hairline-strength gold, for the "elite" card border / accent divider. -->
    <color name="ns_gold_line">#3396631A</color>

    <!-- Semantic -->
    <color name="ns_safe">#FF12A06A</color>
    <color name="ns_safe_container">#1F12A06A</color>
    <color name="ns_warn">#FFC77700</color>
    <color name="ns_warn_container">#1FC77700</color>
    <color name="ns_danger">#FFE0344A</color>
    <color name="ns_danger_container">#1FE0344A</color>
    <color name="ns_info">#FF1C87D6</color>
    <color name="ns_info_container">#1F1C87D6</color>

    <!-- Glow / ring alphas for the SOS hero -->
    <color name="ns_rose_glow_1">#59E8336B</color>
    <color name="ns_rose_glow_2">#26E8336B</color>
    <color name="ns_rose_glow_3">#10E8336B</color>
    <color name="ns_safe_glow">#4012A06A</color>
    <!-- Soft bloom at the top of screen backgrounds: a faint rose-gold blush. -->
    <color name="ns_bloom">#1FE8336B</color>
    <color name="ns_bloom_end">#00FAF8F4</color>
    <!-- Soft ambient shadow for elevated "elite" surfaces. -->
    <color name="ns_shadow">#26000000</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent">#00000000</color>

    <!-- ===================== Legacy aliases ===================== -->
    <color name="bright_red">@color/ns_rose</color>
    <color name="dark_gray">@color/ns_text_muted</color>
    <color name="light_gray">@color/ns_text_faint</color>
