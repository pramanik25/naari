<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Naari Shakti — "Midnight Rose" design tokens.
         Light (Pearl Rose) and dark (Midnight Rose) palettes: near-black indigo surfaces, a rose
         signature accent for SOS, violet for secondary actions and a
         champagne gold used sparingly for premium highlights.
         Use the ns_* tokens in new code. Legacy names at the bottom
         are aliases kept so older references still resolve.
         ============================================================ -->

    <!-- Surfaces (elevation increases downwards) — "Pearl Rose" light palette.
         The dark "Midnight Rose" values live in values-night/colors.xml. -->
    <color name="ns_bg">#FFF7F6FB</color>
    <color name="ns_bg_top">#FFEFEAFB</color>
    <color name="ns_surface">#FFFFFFFF</color>
    <color name="ns_surface_high">#FFF4F1FA</color>
    <color name="ns_surface_highest">#FFE9E4F4</color>
    <color name="ns_stroke">#FFE3DEEE</color>
    <color name="ns_stroke_soft">#14000000</color>
    <color name="ns_scrim">#E6F7F6FB</color>

    <!-- Text -->
    <color name="ns_text">#FF16132A</color>
    <color name="ns_text_muted">#FF5B5775</color>
    <color name="ns_text_faint">#FF8A86A3</color>

    <!-- Signature rose (SOS / primary) -->
    <color name="ns_rose">#FFE8336B</color>
    <color name="ns_rose_deep">#FFC2185B</color>
    <color name="ns_rose_dark">#FF8E0E3E</color>
    <color name="ns_rose_container">#1FE8336B</color>
    <color name="ns_on_rose">#FFFFFFFF</color>

    <!-- Violet (secondary) -->
    <color name="ns_violet">#FF6A5AE0</color>
    <color name="ns_violet_deep">#FF4B3BC4</color>
    <color name="ns_violet_container">#1F6A5AE0</color>

    <!-- Gold (premium accent; deeper on light for legible text) -->
    <color name="ns_gold">#FF9A6A1F</color>
    <color name="ns_gold_container">#1F9A6A1F</color>

    <!-- Semantic -->
    <color name="ns_safe">#FF12A06A</color>
    <color name="ns_safe_container">#1F12A06A</color>
    <color name="ns_warn">#FFC77700</color>
    <color name="ns_warn_container">#1FC77700</color>
    <color name="ns_danger">#FFE0344A</color>
    <color name="ns_danger_container">#1FE0344A</color>
    <color name="ns_info">#FF1C87D6</color>
    <color name="ns_info_container">#1F1C87D6</color>

    <!-- Glow / ring alphas for the SOS hero -->
    <color name="ns_rose_glow_1">#59E8336B</color>
    <color name="ns_rose_glow_2">#26E8336B</color>
    <color name="ns_rose_glow_3">#10E8336B</color>
    <color name="ns_safe_glow">#4012A06A</color>
    <!-- Soft bloom at the top of screen backgrounds -->
    <color name="ns_bloom">#26A594F9</color>
    <color name="ns_bloom_end">#00F7F6FB</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent">#00000000</color>

    <!-- ===================== Legacy aliases ===================== -->
    <color name="bright_red">@color/ns_rose</color>
    <color name="dark_gray">@color/ns_text_muted</color>
