    <!-- ===================== Complaint template: English =====================
         The two templates are the document content of the English / Hindi chips, so they are
         not translated with the UI: each chip always produces its own language. -->
    <string name="ev_tpl_en_to_sho" translatable="false">To,\nThe Station House Officer,\nPolice Station: ____________\nDistrict / City: ____________</string>
    <string name="ev_tpl_en_to_ncw" translatable="false">To,\nThe Chairperson,\nNational Commission for Women,\nNew Delhi</string>
    <string name="ev_tpl_en_date" translatable="false">Date: %1$s</string>
    <string name="ev_tpl_en_subject_sho" translatable="false">Subject: Complaint about an incident on %1$s and request to register an FIR</string>
    <string name="ev_tpl_en_subject_ncw" translatable="false">Subject: Complaint about an incident on %1$s and request for intervention</string>
    <string name="ev_tpl_en_salutation" translatable="false">Respected Sir / Madam,</string>
    <string name="ev_tpl_en_intro" translatable="false">I, %1$s, daughter of %2$s, residing at %3$s, mobile %4$s, respectfully submit the following complaint.</string>
    <string name="ev_tpl_en_sec1" translatable="false">1. Complainant details</string>
    <string name="ev_tpl_en_name" translatable="false">Name: %1$s</string>
    <string name="ev_tpl_en_father" translatable="false">Father\'s / Husband\'s name: %1$s</string>
    <string name="ev_tpl_en_address" translatable="false">Address: %1$s</string>
    <string name="ev_tpl_blank" translatable="false">____________</string>
    <string name="ev_tpl_en_address_pin" translatable="false">%1$s, PIN %2$s</string>
    <string name="ev_tpl_en_mobile" translatable="false">Mobile: %1$s</string>
    <string name="ev_tpl_en_occupation" translatable="false">Occupation: %1$s</string>
    <string name="ev_tpl_en_sec2" translatable="false">2. Incident details</string>
    <string name="ev_tpl_en_inc_date" translatable="false">Date: %1$s</string>
    <string name="ev_tpl_en_inc_time_range" translatable="false">Time: from %1$s to %2$s</string>
    <string name="ev_tpl_en_inc_time" translatable="false">Time: about %1$s</string>
    <string name="ev_tpl_en_inc_place" translatable="false">Place: ____________</string>
    <string name="ev_tpl_en_inc_place_gps" translatable="false">Place: ____________ (approximate GPS location recorded by my phone: %1$s, %2$s)</string>
    <string name="ev_tpl_en_inc_alert" translatable="false">An emergency alert was sent from my phone at %1$s.</string>
    <string name="ev_tpl_en_sec3" translatable="false">3. What happened</string>
    <string name="ev_tpl_en_desc" translatable="false">[Describe in your own words what happened, in the order it happened. Include who was involved (name, or a description of the person or people), any vehicle number, what was said or done to you, any injury or loss, and the names of any witnesses.]</string>
    <string name="ev_tpl_en_sec4" translatable="false">4. Evidence</string>
    <string name="ev_tpl_en_ev_intro" translatable="false">My phone recorded the files below during the incident. The SHA-256 fingerprint of each file is given so that its integrity can be checked. I will provide the original files on request.</string>
    <string name="ev_tpl_en_ev_none" translatable="false">[List any evidence you have: photos, recordings, messages, medical reports, witnesses.]</string>
    <string name="ev_tpl_en_ev_item" translatable="false">%1$d. %2$s, recorded %3$s, %4$s\n   SHA-256: %5$s</string>
    <string name="ev_tpl_en_ev_verified" translatable="false">\n   A copy was received and verified by the Naari Kavach server.</string>
    <string name="ev_tpl_en_kind_photo" translatable="false">Photo</string>
    <string name="ev_tpl_en_kind_audio" translatable="false">Audio recording</string>
    <string name="ev_tpl_en_kind_video" translatable="false">Video recording</string>
    <string name="ev_tpl_en_sec5" translatable="false">5. Request for action</string>
    <string name="ev_tpl_en_request_sho" translatable="false">I request you to register an FIR under the relevant provisions of the Bharatiya Nyaya Sanhita, 2023 and other applicable laws, investigate the matter, take action against the person or persons responsible, and give me a free copy of the FIR. I also request protection if it is needed.</string>
    <string name="ev_tpl_en_request_ncw" translatable="false">I request the Commission to take note of my complaint and direct the authorities concerned to register an FIR, investigate the matter and take action against the person or persons responsible, and to ensure my safety.</string>
    <string name="ev_tpl_en_closing" translatable="false">Yours faithfully,</string>
    <string name="ev_tpl_en_sign_date" translatable="false">Date: %1$s</string>
    <string name="ev_tpl_en_sign_place" translatable="false">Place: ____________</string>

    <!-- ===================== Complaint template: Hindi ===================== -->
    <string name="ev_tpl_hi_to_sho" translatable="false">सेवा में,\nथाना प्रभारी (SHO) महोदय / महोदया,\nथाना: ____________\nज़िला / शहर: ____________</string>
    <string name="ev_tpl_hi_to_ncw" translatable="false">सेवा में,\nअध्यक्ष महोदया,\nराष्ट्रीय महिला आयोग,\nनई दिल्ली</string>
    <string name="ev_tpl_hi_date" translatable="false">दिनांक: %1$s</string>
    <string name="ev_tpl_hi_subject_sho" translatable="false">विषय: दिनांक %1$s को हुई घटना के संबंध में शिकायत एवं प्राथमिकी (FIR) दर्ज करने हेतु प्रार्थना-पत्र</string>
    <string name="ev_tpl_hi_subject_ncw" translatable="false">विषय: दिनांक %1$s को हुई घटना के संबंध में शिकायत एवं हस्तक्षेप हेतु प्रार्थना-पत्र</string>
    <string name="ev_tpl_hi_salutation" translatable="false">महोदय / महोदया,</string>
    <string name="ev_tpl_hi_intro" translatable="false">मैं, %1$s, पुत्री %2$s, निवासी %3$s, मोबाइल %4$s, आपके समक्ष निम्नलिखित शिकायत सादर प्रस्तुत करती हूँ।</string>
    <string name="ev_tpl_hi_sec1" translatable="false">1. शिकायतकर्ता का विवरण</string>
    <string name="ev_tpl_hi_name" translatable="false">नाम: %1$s</string>
    <string name="ev_tpl_hi_father" translatable="false">पिता / पति का नाम: %1$s</string>
    <string name="ev_tpl_hi_address" translatable="false">पता: %1$s</string>
    <string name="ev_tpl_hi_address_pin" translatable="false">%1$s, पिन %2$s</string>
    <string name="ev_tpl_hi_mobile" translatable="false">मोबाइल: %1$s</string>
    <string name="ev_tpl_hi_occupation" translatable="false">व्यवसाय: %1$s</string>
    <string name="ev_tpl_hi_sec2" translatable="false">2. घटना का विवरण</string>
    <string name="ev_tpl_hi_inc_date" translatable="false">दिनांक: %1$s</string>
    <string name="ev_tpl_hi_inc_time_range" translatable="false">समय: %1$s से %2$s तक</string>
    <string name="ev_tpl_hi_inc_time" translatable="false">समय: लगभग %1$s</string>
    <string name="ev_tpl_hi_inc_place" translatable="false">स्थान: ____________</string>
    <string name="ev_tpl_hi_inc_place_gps" translatable="false">स्थान: ____________ (मेरे फ़ोन द्वारा दर्ज अनुमानित GPS स्थान: %1$s, %2$s)</string>
    <string name="ev_tpl_hi_inc_alert" translatable="false">%1$s बजे मेरे फ़ोन से आपातकालीन सूचना (SOS) भेजी गई।</string>
    <string name="ev_tpl_hi_sec3" translatable="false">3. घटना का विवरण (अपने शब्दों में)</string>
    <string name="ev_tpl_hi_desc" translatable="false">[यहाँ अपने शब्दों में, क्रम से लिखें कि क्या हुआ। कौन शामिल था (नाम, या व्यक्ति/व्यक्तियों का हुलिया), वाहन संख्या यदि हो, आपके साथ क्या कहा या किया गया, कोई चोट या नुकसान, और गवाहों के नाम लिखें।]</string>
    <string name="ev_tpl_hi_sec4" translatable="false">4. साक्ष्य</string>
    <string name="ev_tpl_hi_ev_intro" translatable="false">घटना के दौरान मेरे फ़ोन ने नीचे दी गई फ़ाइलें रिकॉर्ड कीं। प्रत्येक फ़ाइल का SHA-256 फ़िंगरप्रिंट दिया गया है, जिससे उसकी प्रामाणिकता जाँची जा सकती है। माँगे जाने पर मैं मूल फ़ाइलें उपलब्ध कराऊँगी।</string>
    <string name="ev_tpl_hi_ev_none" translatable="false">[आपके पास जो भी साक्ष्य हों, उन्हें लिखें: फ़ोटो, रिकॉर्डिंग, संदेश, मेडिकल रिपोर्ट, गवाह।]</string>
    <string name="ev_tpl_hi_ev_item" translatable="false">%1$d. %2$s, रिकॉर्ड समय %3$s, %4$s\n   SHA-256: %5$s</string>
    <string name="ev_tpl_hi_ev_verified" translatable="false">\n   इसकी एक प्रति Naari Kavach सर्वर द्वारा प्राप्त एवं सत्यापित की गई।</string>
    <string name="ev_tpl_hi_kind_photo" translatable="false">फ़ोटो</string>
    <string name="ev_tpl_hi_kind_audio" translatable="false">ऑडियो रिकॉर्डिंग</string>
    <string name="ev_tpl_hi_kind_video" translatable="false">वीडियो रिकॉर्डिंग</string>
    <string name="ev_tpl_hi_sec5" translatable="false">5. कार्रवाई हेतु प्रार्थना</string>
    <string name="ev_tpl_hi_request_sho" translatable="false">अतः आपसे निवेदन है कि भारतीय न्याय संहिता, 2023 एवं अन्य लागू कानूनों की संबंधित धाराओं के अंतर्गत प्राथमिकी (FIR) दर्ज कर मामले की जाँच करें, दोषी व्यक्ति/व्यक्तियों के विरुद्ध उचित कार्रवाई करें तथा मुझे FIR की निःशुल्क प्रति प्रदान करें। आवश्यकता होने पर मुझे सुरक्षा भी प्रदान करें।</string>
    <string name="ev_tpl_hi_request_ncw" translatable="false">अतः आयोग से निवेदन है कि मेरी शिकायत का संज्ञान लेकर संबंधित अधिकारियों को FIR दर्ज करने, मामले की जाँच करने एवं दोषी व्यक्ति/व्यक्तियों के विरुद्ध उचित कार्रवाई करने का निर्देश दें, तथा मेरी सुरक्षा सुनिश्चित करें।</string>
    <string name="ev_tpl_hi_closing" translatable="false">भवदीया,</string>
    <string name="ev_tpl_hi_sign_date" translatable="false">दिनांक: %1$s</string>
    <string name="ev_tpl_hi_sign_place" translatable="false">स्थान: ____________</string>
