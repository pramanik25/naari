<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Naari Kavach design system — components & typography.
         All screens use the Ns.* styles; do not hardcode colours in
         layouts, reference @color/ns_* tokens instead.
         ============================================================ -->

    <!-- ===================== Shapes ===================== -->
    <style name="Ns.Shape.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Ns.Shape.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Ns.Shape.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="Ns.Shape.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===================== Typography =====================
         Display  34sp black  — hero numbers / splash wordmark
         Headline 26sp bold   — screen titles
         Title    18sp medium — card titles, section heads
         Body     15sp        — paragraphs
         Label    13sp medium — buttons, chips, meta
         Overline 11sp medium, tracked caps — section eyebrows      -->
    <style name="Ns.Text.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/roboto_black</item>
        <item name="android:fontFamily">@font/roboto_black</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/ns_text</item>
    </style>
    <style name="Ns.Text.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ns_text</item>
    </style>
    <style name="Ns.Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ns_text</item>
    </style>
    <style name="Ns.Text.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ns_text</item>
    </style>
    <style name="Ns.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/ns_text_muted</item>
    </style>
    <style name="Ns.Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ns_text_faint</item>
    </style>
    <style name="Ns.Text.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Ns.Text.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ns_gold</item>
    </style>

    <!-- ===================== Buttons ===================== -->
    <!-- Primary: rose filled pill, 56dp tall. -->
    <style name="Ns.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="backgroundTint">@color/ns_button_primary_bg</item>
        <item name="android:textColor">@color/ns_on_rose</item>
        <item name="iconTint">@color/ns_on_rose</item>
        <item name="android:textAppearance">@style/Ns.Text.Label</item>
        <item name="shapeAppearance">@style/Ns.Shape.Pill</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>
    <!-- Secondary: tonal surface pill. -->
    <style name="Ns.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="backgroundTint">@color/ns_surface_highest</item>
        <item name="android:textColor">@color/ns_text</item>
        <item name="iconTint">@color/ns_text</item>
        <item name="android:textAppearance">@style/Ns.Text.Label</item>
        <item name="shapeAppearance">@style/Ns.Shape.Pill</item>
    </style>
    <!-- Outlined: hairline pill. -->
    <style name="Ns.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="strokeColor">@color/ns_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ns_text</item>
        <item name="iconTint">@color/ns_text</item>
        <item name="android:textAppearance">@style/Ns.Text.Label</item>
        <item name="shapeAppearance">@style/Ns.Shape.Pill</item>
    </style>
    <!-- Danger: for destructive / stop actions. -->
    <style name="Ns.Button.Danger" parent="Ns.Button">
        <item name="backgroundTint">@color/ns_danger</item>
    </style>
    <!-- Safe: confirm / "I'm safe". -->
    <style name="Ns.Button.Safe" parent="Ns.Button">
        <item name="backgroundTint">@color/ns_safe</item>
        <item name="android:textColor">@color/ns_bg</item>
        <item name="iconTint">@color/ns_bg</item>
    </style>
    <style name="Ns.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ns_rose</item>
        <item name="iconTint">@color/ns_rose</item>
        <item name="android:textAppearance">@style/Ns.Text.Label</item>
    </style>
    <style name="Ns.Button.Text.Muted">
        <item name="android:textColor">@color/ns_text_muted</item>
        <item name="iconTint">@color/ns_text_muted</item>
    </style>
    <!-- Round 48dp icon button on a tonal surface (toolbar actions, back). -->
    <style name="Ns.Button.Icon" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/ns_surface_high</item>
        <item name="iconTint">@color/ns_text</item>
        <item name="strokeColor">@color/ns_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/Ns.Shape.Pill</item>
    </style>

    <!-- ===================== Cards ===================== -->
    <!-- Default card: surface, hairline stroke, 20dp corners, flat. -->
    <style name="Ns.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ns_surface</item>
        <item name="strokeColor">@color/ns_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/Ns.Shape.Medium</item>
        <item name="rippleColor">#14FFFFFF</item>
    </style>
    <!-- Raised card: one step brighter, for emphasis. -->
    <style name="Ns.Card.Raised">
        <item name="cardBackgroundColor">@color/ns_surface_high</item>
    </style>
    <!-- Elite: a fine gold hairline and a soft real shadow, for one hero moment per screen
         (a headline status card, a plan/summary panel). Don't use for ordinary content cards —
         it reads as ceremonial, not decorative, and loses that if overused. -->
    <style name="Ns.Card.Elite">
        <item name="cardBackgroundColor">@color/ns_surface_high</item>
        <item name="strokeColor">@color/ns_gold_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">6dp</item>
        <item name="shapeAppearance">@style/Ns.Shape.Large</item>
    </style>
    <!-- Action tile on Home: clickable, taller padding set in layout. -->
    <style name="Ns.Card.Tile">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:checkable">false</item>
    </style>

    <!-- ===================== Inputs ===================== -->
    <style name="Ns.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/ns_surface</item>
        <item name="boxStrokeColor">@color/ns_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/ns_rose</item>
        <item name="android:textColorHint">@color/ns_text_faint</item>
        <item name="startIconTint">@color/ns_text_muted</item>
        <item name="endIconTint">@color/ns_text_muted</item>
        <item name="errorTextColor">@color/ns_danger</item>
        <item name="boxStrokeErrorColor">@color/ns_danger</item>
    </style>
    <style name="Ns.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/ns_surface</item>
        <item name="boxStrokeColor">@color/ns_input_stroke</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/ns_rose</item>
    </style>

    <!-- ===================== Controls ===================== -->
    <style name="Ns.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/ns_switch_track</item>
        <item name="thumbTint">@color/ns_switch_thumb</item>
        <item name="trackDecorationTint">@color/ns_stroke</item>
    </style>
    <style name="Ns.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/ns_chip_bg</item>
        <item name="chipStrokeColor">@color/ns_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/ns_chip_text</item>
        <item name="android:textAppearance">@style/Ns.Text.Label</item>
        <item name="checkedIconTint">@color/ns_rose</item>
        <item name="shapeAppearance">@style/Ns.Shape.Pill</item>
        <item name="chipMinHeight">40dp</item>
    </style>
    <style name="Ns.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/ns_rose</item>
        <item name="trackColorInactive">@color/ns_surface_highest</item>
        <item name="thumbColor">@color/ns_rose</item>
        <item name="haloColor">@color/ns_rose_container</item>
        <item name="tickVisible">false</item>
    </style>
    <style name="Ns.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/Ns.Text.Title</item>
        <item name="titleTextColor">@color/ns_text</item>
        <item name="navigationIconTint">@color/ns_text</item>
    </style>
    <style name="Ns.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/ns_surface</item>
        <item name="backgroundTint">@color/ns_surface</item>
        <item name="itemIconTint">@color/ns_nav_item</item>
        <item name="itemTextColor">@color/ns_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Ns.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/Ns.Text.Label</item>
        <item name="itemTextAppearanceInactive">@style/Ns.Text.Label</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Ns.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ns_rose_container</item>
    </style>

    <!-- ===================== Layout helpers ===================== -->
    <!-- Screen root: background + horizontal gutter. -->
    <style name="Ns.Screen" parent="">
        <item name="android:background">@color/ns_bg</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
    <!-- Section eyebrow above a group of cards. -->
    <style name="Ns.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textAppearance">@style/Ns.Text.Overline</item>
    </style>
    <!-- 44dp rounded-square icon badge used at the start of rows and tiles. -->
    <style name="Ns.IconBadge" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/ns_icon_badge</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <!-- Fine gold hairline, for a ceremonial rule under a hero headline. Sparingly. -->
    <style name="Ns.Divider.Gold" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@color/ns_gold_bright</item>
    </style>
</resources>
