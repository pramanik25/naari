<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".evidence.IncidentsActivity">

    <!-- ============ Header ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ns_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/ns_gutter"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Ns.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/ev_cd_back"
            app:icon="@drawable/ua_ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ev_inc_overline"
            android:textAppearance="@style/Ns.Text.Overline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ev_inc_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:id="@+id/countText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ns_pill"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/Ns.Text.Label"
                android:textColor="@color/ns_text_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="3 incidents"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ev_inc_body"
            android:textAppearance="@style/Ns.Text.Body" />
    </LinearLayout>

    <!-- ============ Content ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="48dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                style="@style/Ns.IconBadge"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:backgroundTint="@color/ns_violet_container"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ev_ic_history"
                app:tint="@color/ns_violet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/ev_inc_empty_title"
                android:textAppearance="@style/Ns.Text.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/ev_inc_empty_body"
                android:textAppearance="@style/Ns.Text.Body" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/ns_rose"
            app:trackColor="@android:color/transparent" />
    </FrameLayout>
</LinearLayout>
