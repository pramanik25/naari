<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".journey.CheckInActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/jr_back"
                app:icon="@drawable/ua_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/jr_ci_eyebrow"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jr_ci_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jr_ci_body"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- ======================= Setup ======================= -->
            <LinearLayout
                android:id="@+id/setupGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Ns.SectionLabel"
                    android:text="@string/jr_ci_section_time" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ns_card_padding">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/durationChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:checkedChip="@+id/chip30"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip15"
                                style="@style/Ns.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/jr_ci_15" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip30"
                                style="@style/Ns.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/jr_ci_30" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip45"
                                style="@style/Ns.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/jr_ci_45" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip60"
                                style="@style/Ns.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/jr_ci_60" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCustom"
                                style="@style/Ns.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/jr_ci_custom"
                                app:chipIcon="@drawable/ua_ic_schedule"
                                app:chipIconSize="18dp"
                                app:chipIconTint="@color/ns_text_muted" />
                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            android:id="@+id/dueText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/Ns.Text.Subtitle"
                            tools:text="Due at 21:45" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Ns.SectionLabel"
                    android:text="@string/jr_ci_section_note" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/noteLayout"
                    style="@style/Ns.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/jr_ci_note_hint"
                    app:placeholderText="@string/jr_ci_note_placeholder"
                    app:startIconDrawable="@drawable/ua_ic_edit">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Ns.SectionLabel"
                    android:text="@string/jr_ci_section_contacts" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ns_card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/contactsIcon"
                                style="@style/Ns.IconBadge"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ua_ic_group" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/contactsTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/Ns.Text.Subtitle"
                                    tools:text="3 contacts" />

                                <TextView
                                    android:id="@+id/contactsSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/Ns.Text.Caption"
                                    android:textColor="@color/ns_text_muted"
                                    tools:text="Mom, Riya, Aarti" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addContactsButton"
                            style="@style/Ns.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/jr_add_contacts"
                            android:visibility="gone"
                            app:icon="@drawable/ub_ic_person_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/exactAlarmRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ub_rounded_16"
                    android:backgroundTint="@color/ns_warn_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ua_ic_alarm"
                        app:tint="@color/ns_warn" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/jr_ci_exact_alarm"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exactAlarmButton"
                        style="@style/Ns.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/jr_allow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/cloudNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="@style/Ns.Text.Caption"
                    tools:text="@string/jr_ci_cloud_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    style="@style/Ns.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/jr_ci_start"
                    app:icon="@drawable/ua_ic_timer" />
            </LinearLayout>

            <!-- ======================= Active ======================= -->
            <LinearLayout
                android:id="@+id/activeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="292dp"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/ring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:max="1000"
                        app:indicatorColor="@color/ns_safe"
                        app:indicatorSize="260dp"
                        app:trackColor="@color/ns_surface_highest"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/countdownText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/Ns.Text.Display"
                            android:textSize="48sp"
                            tools:text="24:13" />

                        <TextView
                            android:id="@+id/countdownCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Ns.Text.Label"
                            android:textColor="@color/ns_text_muted"
                            tools:text="left · due 21:45" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/activeNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/Ns.Text.Subtitle"
                    tools:text="Walking home from metro" />

                <LinearLayout
                    android:id="@+id/activeStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ub_rounded_16"
                    android:backgroundTint="@color/ns_safe_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <View
                        android:id="@+id/activeDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/ns_dot" />

                    <TextView
                        android:id="@+id/activeStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text"
                        tools:text="If you don't check in, your 3 contacts are alerted automatically." />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/safeButton"
                    style="@style/Ns.Button.Safe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/jr_ci_safe"
                    app:icon="@drawable/ua_ic_check" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/extendButton"
                        style="@style/Ns.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/jr_ci_extend"
                        app:icon="@drawable/ua_ic_timer" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/helpButton"
                        style="@style/Ns.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/jr_ci_help"
                        app:icon="@drawable/ua_ic_warning" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
