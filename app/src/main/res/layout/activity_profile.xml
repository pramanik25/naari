<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="Home_Activity.ProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="24dp">

            <!-- ============ Header ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_back"
                app:icon="@drawable/ua_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_overline"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/profile_body"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- ============ Avatar ============ -->
            <FrameLayout
                android:id="@+id/avatarButton"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:contentDescription="@string/cd_profile_photo"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ua_avatar_bg"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Ns.Shape.Pill" />

                <TextView
                    android:id="@+id/avatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/Ns.Text.Headline"
                    android:visibility="gone"
                    tools:text="PS"
                    tools:visibility="visible" />

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/ua_edit_badge"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ua_ic_edit"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/avatarHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/profile_add_photo"
                android:textAppearance="@style/Ns.Text.Caption" />

            <!-- ============ Personal ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/profile_section_personal" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/profile_full_name"
                        app:startIconDrawable="@drawable/ua_ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fatherNameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_guardian_name"
                        app:startIconDrawable="@drawable/ua_ic_group">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/fatherNameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addressLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_address"
                        app:startIconDrawable="@drawable/ua_ic_home">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/addressEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textPostalAddress|textMultiLine|textCapWords"
                            android:maxLines="4"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/pincodeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/pincode"
                        app:startIconDrawable="@drawable/ua_ic_pin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pincodeEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="6"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Contact ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/profile_section_contact" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/mobileLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/profile_mobile"
                        app:helperText="@string/profile_mobile_helper"
                        app:helperTextTextColor="@color/ns_text_faint"
                        app:startIconDrawable="@drawable/ua_ic_phone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mobileNumberEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLength="16"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fatherMobileLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_guardian_mobile"
                        app:startIconDrawable="@drawable/ua_ic_phone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/fatherMobileNumberEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLength="16"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Occupation ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/profile_section_occupation" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/occupationGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStudent"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student"
                            app:chipIcon="@drawable/ua_ic_school"
                            app:chipIconSize="18dp"
                            app:chipIconTint="@color/ns_text_muted"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCollege"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_college"
                            app:chipIcon="@drawable/ua_ic_school"
                            app:chipIconSize="18dp"
                            app:chipIconTint="@color/ns_text_muted"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipWorking"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/working"
                            app:chipIcon="@drawable/ua_ic_work"
                            app:chipIconSize="18dp"
                            app:chipIconTint="@color/ns_text_muted"
                            app:chipIconVisible="true" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Student -->
                    <LinearLayout
                        android:id="@+id/studentFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/schoolLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/school_name"
                            app:startIconDrawable="@drawable/ua_ic_school">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/schoolNameEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/classLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/your_class"
                            app:startIconDrawable="@drawable/ua_ic_school">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/classEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- College -->
                    <LinearLayout
                        android:id="@+id/collegeFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/collegeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/college_name"
                            app:startIconDrawable="@drawable/ua_ic_school">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/collegeNameEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/degreeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/profile_degree"
                            app:startIconDrawable="@drawable/ua_ic_school">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/degreeEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Working -->
                    <LinearLayout
                        android:id="@+id/workingFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/companyLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/company_name"
                            app:startIconDrawable="@drawable/ua_ic_work">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/companyNameEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/departmentLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/department"
                            app:startIconDrawable="@drawable/ua_ic_group">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/departmentEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/officeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/profile_office"
                            app:startIconDrawable="@drawable/ua_ic_location">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/officeNameEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============ Sticky save ============ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ns_stroke" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ns_bg"
        android:paddingStart="@dimen/ns_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/ns_gutter"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Ns.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_profile" />
    </FrameLayout>
</LinearLayout>
