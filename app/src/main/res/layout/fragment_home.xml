<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/ns_gutter"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/ns_gutter"
        android:paddingBottom="32dp">

        <!-- ============ Header: greeting + avatar ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Ns.Text.Overline"
                    tools:text="Good evening" />

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/Ns.Text.Headline"
                    tools:text="Priya" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/avatarButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_open_profile"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ua_avatar_bg"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Ns.Shape.Pill" />

                <TextView
                    android:id="@+id/avatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/Ns.Text.Subtitle"
                    android:visibility="gone"
                    tools:text="PS"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ Protection status ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/protectionCard"
            style="@style/Ns.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ns_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/statusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ns_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/ns_dot" />

                        <TextView
                            android:id="@+id/statusPillText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAppearance="@style/Ns.Text.Label"
                            android:textSize="12sp"
                            tools:text="Protected" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/protectionSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cd_protection_switch"
                        android:minHeight="48dp"
                        android:saveEnabled="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/protectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/Ns.Text.Title"
                    tools:text="Protection is on" />

                <TextView
                    android:id="@+id/protectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/Ns.Text.Body"
                    tools:text="Listening for “help” · Shake · Power ×3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Journey: live check-in / cab banner (journey module) ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/jrJourneyBanner"
            style="@style/Ns.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ns_card_padding"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/jrJourneyIcon"
                    style="@style/Ns.IconBadge"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ua_ic_timer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/jrJourneyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textAppearance="@style/Ns.Text.Subtitle"
                        tools:text="Check-in running" />

                    <TextView
                        android:id="@+id/jrJourneySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityLiveRegion="none"
                        android:maxLines="1"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text_muted"
                        tools:text="24:13 left · due 21:45 · tap to open" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ua_ic_chevron_right"
                    app:tint="@color/ns_text_faint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Setup nudges ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contactsNudge"
            style="@style/Ns.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ns_warn_container"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <include
                android:id="@+id/contactsNudgeRow"
                layout="@layout/ua_item_row" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/triggerNudge"
            style="@style/Ns.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <include
                android:id="@+id/triggerNudgeRow"
                layout="@layout/ua_item_row" />
        </com.google.android.material.card.MaterialCardView>

        <!-- One-time "Help women near you?" (cloud.NearbyHelperCard) -->
        <include
            android:id="@+id/nbHelperCard"
            layout="@layout/cl_card_nearby_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- ============ SOS hero ============ -->
        <FrameLayout
            android:id="@+id/sosHero"
            android:layout_width="match_parent"
            android:layout_height="284dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/sosRing1"
                android:layout_width="@dimen/ns_sos_size"
                android:layout_height="@dimen/ns_sos_size"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ns_sos_ring" />

            <View
                android:id="@+id/sosRing2"
                android:layout_width="@dimen/ns_sos_size"
                android:layout_height="@dimen/ns_sos_size"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ns_sos_ring" />

            <View
                android:id="@+id/sosRing3"
                android:layout_width="@dimen/ns_sos_size"
                android:layout_height="@dimen/ns_sos_size"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ns_sos_ring" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/sosProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:max="1000"
                app:indicatorColor="@color/ns_rose"
                app:indicatorSize="206dp"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="3dp"
                app:trackThickness="5dp" />

            <FrameLayout
                android:id="@+id/sosButton"
                android:layout_width="@dimen/ns_sos_size"
                android:layout_height="@dimen/ns_sos_size"
                android:layout_gravity="center"
                android:background="@drawable/ns_sos_core"
                android:clickable="true"
                android:contentDescription="@string/sos_cd"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sosLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sos_label"
                        android:textAppearance="@style/Ns.Text.Display"
                        android:textColor="@color/white"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/sosHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.85"
                        android:text="@string/sos_hint"
                        android:textAppearance="@style/Ns.Text.Label"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/sosCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="@string/sos_caption"
            android:textAppearance="@style/Ns.Text.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopSosButton"
            style="@style/Ns.Button.Safe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sos_stop"
            android:visibility="gone"
            app:icon="@drawable/ua_ic_check" />

        <!-- ============ Quick actions ============ -->
        <TextView
            style="@style/Ns.SectionLabel"
            android:layout_marginTop="32dp"
            android:text="@string/home_quick_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/qaTrigger"
                layout="@layout/ua_item_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/qaContacts"
                layout="@layout/ua_item_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/qaPolice"
                layout="@layout/ua_item_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/qaHelplines"
                layout="@layout/ua_item_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/qaLiveLocation"
                layout="@layout/ua_item_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/qaSafeZones"
                layout="@layout/ua_item_quick_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ============ Safety tools hub entry (journey module) ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/jrSafetyToolsCard"
            style="@style/Ns.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/jr_home_tools_cd"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/jr_hero_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ns_card_padding"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <ImageView
                    style="@style/Ns.IconBadge"
                    android:backgroundTint="@color/ns_stroke_soft"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ua_ic_shield"
                    app:tint="@color/ns_on_rose" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jr_home_tools_title"
                        android:textAppearance="@style/Ns.Text.Title"
                        android:textColor="@color/ns_on_rose" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.85"
                        android:text="@string/jr_home_tools_sub"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_on_rose" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ua_ic_chevron_right"
                    app:tint="@color/ns_on_rose" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Every day: commute, cycle tracker, quiz (daily module) ============ -->
        <TextView
            style="@style/Ns.SectionLabel"
            android:text="@string/dl_section_daily" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:id="@+id/dlHomeCommute"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/dlHomeCommuteIcon"
                        style="@style/Ns.IconBadge"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ua_ic_near_me" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/dl_home_commute"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:id="@+id/dlHomeCommuteCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/dl_home_commute_cap"
                        android:textAppearance="@style/Ns.Text.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dlHomeCycle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/dlHomeCycleIcon"
                        style="@style/Ns.IconBadge"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ua_ic_event" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/dl_home_cycle"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/dl_home_cycle_cap"
                        android:textAppearance="@style/Ns.Text.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dlHomeQuiz"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/dlHomeQuizIcon"
                        style="@style/Ns.IconBadge"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ub_ic_lightbulb" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/dl_home_quiz"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:id="@+id/dlHomeQuizCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/dl_home_quiz_cap"
                        android:textAppearance="@style/Ns.Text.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Together: family circle, safety map, community (together module) ============ -->
        <TextView
            style="@style/Ns.SectionLabel"
            android:text="@string/tg_section" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:id="@+id/tgHomeCircle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/tgHomeCircleIcon"
                        style="@style/Ns.IconBadge"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ua_ic_group" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/tg_home_circle"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/tg_home_circle_cap"
                        android:textAppearance="@style/Ns.Text.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tgHomeMap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/tgHomeMapIcon"
                        style="@style/Ns.IconBadge"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ub_ic_map" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/tg_home_map"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/tg_home_map_cap"
                        android:textAppearance="@style/Ns.Text.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tgHomeCommunity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/tgHomeCommunityIcon"
                        style="@style/Ns.IconBadge"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ub_ic_chat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/tg_home_community"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/tg_home_community_cap"
                        android:textAppearance="@style/Ns.Text.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Safety kit rows ============ -->
        <TextView
            style="@style/Ns.SectionLabel"
            android:text="@string/home_your_safety_kit" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowSchedule"
                    layout="@layout/ua_item_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="80dp"
                    android:background="@color/ns_stroke" />

                <include
                    android:id="@+id/rowVault"
                    layout="@layout/ua_item_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Donate banner ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/donateBanner"
            style="@style/Ns.Card.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ns_card_padding"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    style="@style/Ns.IconBadge"
                    android:backgroundTint="@color/ns_rose_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ns_ic_heart"
                    app:tint="@color/ns_rose" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/home_donate_title"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="@string/home_donate_sub"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text_muted" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ua_ic_chevron_right"
                    app:tint="@color/ns_text_faint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
