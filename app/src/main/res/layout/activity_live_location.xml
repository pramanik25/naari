<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="Home_Activity.LiveLocationActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="40dp">

            <!-- ============ Header ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/ub_back"
                app:icon="@drawable/ub_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ub_live_eyebrow"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ub_live_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ub_live_desc"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- ============ Map ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapCard"
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="20dp"
                app:shapeAppearance="@style/Ns.Shape.Large">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ub_live_map_cd" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_gravity="top"
                        android:background="@drawable/ub_map_scrim_top"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:id="@+id/mapStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/ns_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <View
                            android:id="@+id/mapStatusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/ns_dot" />

                        <TextView
                            android:id="@+id/mapStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/ub_live_status_idle"
                            android:textAppearance="@style/Ns.Text.Label"
                            android:textColor="@color/ns_text" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recenterButton"
                        style="@style/Ns.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:contentDescription="@string/ub_recenter_cd"
                        app:icon="@drawable/ub_ic_my_location" />

                    <!-- Shown when location permission is missing -->
                    <LinearLayout
                        android:id="@+id/mapPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/ns_surface"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <ImageView
                            style="@style/Ns.IconBadge"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="15dp"
                            android:backgroundTint="@color/ns_rose_container"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ub_ic_location"
                            app:tint="@color/ns_rose" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/ub_live_perm_title"
                            android:textAppearance="@style/Ns.Text.Subtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/ub_live_perm_body"
                            android:textAppearance="@style/Ns.Text.Caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/grantLocationButton"
                            style="@style/Ns.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/ub_allow_location" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Address ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ns_card_padding"
                    android:paddingTop="@dimen/ns_card_padding"
                    android:paddingEnd="@dimen/ns_card_padding"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ub_live_you_are_here"
                        android:textAppearance="@style/Ns.Text.Overline" />

                    <TextView
                        android:id="@+id/addressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/ub_live_finding"
                        android:textAppearance="@style/Ns.Text.Title" />

                    <TextView
                        android:id="@+id/coordsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/Ns.Text.Caption"
                        tools:text="28.61390, 77.20900 · ±12 m" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyButton"
                            style="@style/Ns.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:enabled="false"
                            android:text="@string/ub_copy"
                            app:icon="@drawable/ub_ic_copy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openMapsButton"
                            style="@style/Ns.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:enabled="false"
                            android:text="@string/ub_open_in_maps"
                            app:icon="@drawable/ub_ic_map" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Share once ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/ub_live_section_once" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ns_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Ns.IconBadge"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/ns_violet_container"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ub_ic_share"
                            app:tint="@color/ns_violet" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ub_live_once_title"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ub_live_once_caption"
                                android:textAppearance="@style/Ns.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/textContactsButton"
                            style="@style/Ns.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/ub_text_contacts"
                            app:icon="@drawable/ub_ic_sms" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shareSheetButton"
                            style="@style/Ns.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/ub_share"
                            app:icon="@drawable/ub_ic_share" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Live sharing ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/ub_live_section_live" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Ns.Card.Raised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="@dimen/ns_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Ns.IconBadge"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/ns_rose_container"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ub_ic_timer"
                            app:tint="@color/ns_rose" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ub_live_live_title"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ub_live_live_caption"
                                android:textAppearance="@style/Ns.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Running status -->
                    <LinearLayout
                        android:id="@+id/liveStatusRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/ub_rounded_16"
                        android:backgroundTint="@color/ns_safe_container"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp">

                            <View
                                android:id="@+id/livePulse"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0"
                                android:background="@drawable/ns_dot" />

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="center"
                                android:background="@drawable/ns_dot" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/liveStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/Ns.Text.Subtitle"
                            android:textColor="@color/ns_safe"
                            tools:text="Sharing with 3 contacts · 23:41 left" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/durationLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ub_live_share_for"
                        android:textAppearance="@style/Ns.Text.Caption" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/durationChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:checkedChip="@+id/chip30"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip15"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ub_live_15" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip30"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ub_live_30" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip60"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ub_live_60" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip120"
                            style="@style/Ns.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ub_live_120" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- No contacts -->
                    <LinearLayout
                        android:id="@+id/noContactsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/ub_rounded_16"
                        android:backgroundTint="@color/ns_warn_container"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="6dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ub_ic_warning"
                            app:tint="@color/ns_warn" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/ub_live_no_contacts"
                            android:textAppearance="@style/Ns.Text.Caption"
                            android:textColor="@color/ns_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addContactsButton"
                            style="@style/Ns.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/ub_add_contacts" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/liveButton"
                        style="@style/Ns.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ub_live_start"
                        app:icon="@drawable/ub_ic_location" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
