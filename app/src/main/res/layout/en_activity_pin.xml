<?xml version="1.0" encoding="utf-8"?>
<!-- App PIN / duress PIN setup and verification (PinActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:clipChildren="false"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/ns_gutter"
    android:paddingEnd="@dimen/ns_gutter">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pinBackButton"
        style="@style/Ns.Button.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/ns_space_2"
        android:contentDescription="@string/en_back"
        app:icon="@drawable/en_ic_arrow_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ns_space_4"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/pinIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ns_icon_badge"
            android:backgroundTint="@color/ns_rose_container"
            android:importantForAccessibility="no"
            android:padding="15dp"
            android:src="@drawable/en_ic_lock"
            app:tint="@color/ns_rose" />

        <TextView
            android:id="@+id/pinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ns_space_5"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="@style/Ns.Text.Headline" />

        <TextView
            android:id="@+id/pinSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ns_space_2"
            android:gravity="center"
            android:textAppearance="@style/Ns.Text.Body" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <com.example.naarishakti.security.PinPadView
            android:id="@+id/pinPad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/ns_space_4" />

        <!-- Manage options and the duress PIN explanation. -->
        <ScrollView
            android:id="@+id/pinOptions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingTop="@dimen/ns_space_6"
                android:paddingBottom="@dimen/ns_space_6">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Ns.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/pinOptionsBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/ns_card_padding"
                        android:textAppearance="@style/Ns.Text.Body" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinOptionPrimary"
                    style="@style/Ns.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ns_space_6" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinOptionSecondary"
                    style="@style/Ns.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ns_space_3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinOptionDanger"
                    style="@style/Ns.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ns_space_2"
                    android:textColor="@color/ns_danger" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
