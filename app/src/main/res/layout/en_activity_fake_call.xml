<?xml version="1.0" encoding="utf-8"?>
<!-- Fake incoming call: neutral stock-dialer look (not app-branded). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/en_call_bg"
    android:fitsSystemWindows="true">

    <!-- Caller -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/en_fake_incoming"
            android:textColor="@color/en_call_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/en_call_text"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/callLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/en_fake_mobile"
            android:textColor="@color/en_call_text_secondary"
            android:textSize="16sp" />

        <Chronometer
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/en_call_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/callAvatar"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/en_call_avatar">

            <TextView
                android:id="@+id/callInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/en_call_text"
                android:textSize="48sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Ringing controls -->
    <LinearLayout
        android:id="@+id/ringingGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/en_fake_swipe_hint"
            android:textColor="@color/en_call_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/declineButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/en_call_decline_btn"
                    android:contentDescription="@string/en_fake_decline"
                    android:src="@drawable/en_ic_call_end"
                    app:tint="@color/en_call_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="no"
                    android:text="@string/en_fake_decline"
                    android:textColor="@color/en_call_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/acceptButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/en_call_accept_btn"
                    android:contentDescription="@string/en_fake_answer"
                    android:src="@drawable/eng_ic_call"
                    app:tint="@color/en_call_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="no"
                    android:text="@string/en_fake_answer"
                    android:textColor="@color/en_call_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- In-call controls -->
    <LinearLayout
        android:id="@+id/inCallGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/muteButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/en_call_round_btn"
                    android:contentDescription="@string/en_fake_mute"
                    android:src="@drawable/en_ic_mic_off"
                    app:tint="@color/en_call_toggle_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/en_fake_mute"
                    android:textColor="@color/en_call_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/keypadButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/en_call_round_btn"
                    android:contentDescription="@string/en_fake_keypad"
                    android:src="@drawable/en_ic_dialpad"
                    app:tint="@color/en_call_toggle_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/en_fake_keypad"
                    android:textColor="@color/en_call_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/speakerButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/en_call_round_btn"
                    android:contentDescription="@string/en_fake_speaker"
                    android:src="@drawable/en_ic_volume_up"
                    app:tint="@color/en_call_toggle_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/en_fake_speaker"
                    android:textColor="@color/en_call_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/endButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/en_call_decline_btn"
            android:contentDescription="@string/en_fake_end"
            android:src="@drawable/en_ic_call_end"
            app:tint="@color/en_call_text" />
    </LinearLayout>
</FrameLayout>
