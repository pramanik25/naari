<?xml version="1.0" encoding="utf-8"?>
<!-- One evidence file inside an expanded incident: thumbnail (photo/video) or play button (audio),
     title, status, short hash and a copy-hash action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ns_card_padding"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/thumbCard"
            style="@style/Ns.Card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/ns_surface_highest"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/kindIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ua_ic_camera"
                app:tint="@color/ns_text" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            style="@style/Ns.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/ev_cd_play"
            android:visibility="gone"
            app:backgroundTint="@color/ns_rose_container"
            app:icon="@drawable/ev_ic_play"
            app:iconTint="@color/ns_rose"
            app:strokeWidth="0dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Ns.Text.Label"
            android:textColor="@color/ns_text"
            tools:text="Audio clip · 21:41:05" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Ns.Text.Caption"
            tools:text="164 kB · Uploaded · verified" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:visibility="gone"
            app:indicatorColor="@color/ns_rose"
            app:trackColor="@color/ns_surface_highest"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp"
            tools:progress="300"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textAppearance="@style/Ns.Text.Caption"
            android:textSize="12sp"
            tools:text="SHA-256 3fa2b1c9d0e1…" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/ev_cd_copy_hash"
        app:icon="@drawable/ub_ic_copy"
        app:iconSize="18dp"
        app:iconTint="@color/ns_text_muted" />
</LinearLayout>
