<?xml version="1.0" encoding="utf-8"?>
<!-- One safe place: category badge, name, type chip + distance + 24h, Call / Navigate. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ns_card_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/ns_card_padding"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon"
                style="@style/Ns.IconBadge"
                android:importantForAccessibility="no"
                tools:src="@drawable/ua_ic_police" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/Ns.Text.Subtitle"
                    tools:text="Connaught Place Police Station" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/typeChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ns_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textAppearance="@style/Ns.Text.Label"
                        android:textSize="12sp"
                        tools:text="Police" />

                    <TextView
                        android:id="@+id/distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text_muted"
                        tools:text="650 m" />

                    <TextView
                        android:id="@+id/open24"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ns_pill"
                        android:backgroundTint="@color/ns_safe_container"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/jr_sp_open_24h"
                        android:textAppearance="@style/Ns.Text.Label"
                        android:textColor="@color/ns_safe"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/callButton"
                style="@style/Ns.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/jr_sp_call"
                app:icon="@drawable/ua_ic_phone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigateButton"
                style="@style/Ns.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/jr_sp_navigate"
                app:icon="@drawable/ua_ic_near_me" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
