<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="Location.GeofenceSettingsActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="40dp">

            <!-- ============ Header ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/ub_back"
                app:icon="@drawable/ub_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ub_zone_eyebrow"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ub_zone_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ub_zone_desc"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- ============ Background-location warning ============ -->
            <LinearLayout
                android:id="@+id/permissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/ub_rounded_16"
                android:backgroundTint="@color/ns_warn_container"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ub_ic_warning"
                    app:tint="@color/ns_warn" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/permissionWarningTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ub_zone_bg_title"
                        android:textAppearance="@style/Ns.Text.Subtitle"
                        android:textColor="@color/ns_warn" />

                    <TextView
                        android:id="@+id/permissionWarningBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ub_zone_bg_body"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permissionFixButton"
                        style="@style/Ns.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="-12dp"
                        android:text="@string/ub_zone_bg_fix"
                        android:textColor="@color/ns_warn" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Map ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapCard"
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="20dp"
                app:shapeAppearance="@style/Ns.Shape.Large">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ub_zone_map_cd" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_gravity="top"
                        android:background="@drawable/ub_map_scrim_top"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/mapHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/ns_pill"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="@string/ub_zone_map_hint"
                        android:textAppearance="@style/Ns.Text.Label"
                        android:textColor="@color/ns_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/myLocationButton"
                        style="@style/Ns.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:contentDescription="@string/ub_zone_use_my_location"
                        app:icon="@drawable/ub_ic_my_location" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ New zone ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ns_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ub_zone_new"
                        android:textAppearance="@style/Ns.Text.Overline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/pinBadge"
                            style="@style/Ns.IconBadge"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/ns_surface_highest"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ub_ic_location"
                            app:tint="@color/ns_text_muted" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pinTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ub_zone_no_pin"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:id="@+id/pinCoords"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ub_zone_no_pin_caption"
                                android:textAppearance="@style/Ns.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/ub_zone_name_hint"
                        app:counterEnabled="true"
                        app:counterMaxLength="30"
                        app:startIconDrawable="@drawable/ub_ic_home">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords"
                            android:maxLength="30"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Radius -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ub_zone_radius"
                            android:textAppearance="@style/Ns.Text.Subtitle" />

                        <TextView
                            android:id="@+id/radiusValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Ns.Text.Title"
                            android:textColor="@color/ns_rose"
                            tools:text="350 m" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/radiusSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ub_zone_radius"
                        android:stepSize="50"
                        android:value="300"
                        android:valueFrom="100"
                        android:valueTo="2000" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ub_zone_radius_hint"
                        android:textAppearance="@style/Ns.Text.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addZoneButton"
                        style="@style/Ns.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/ub_zone_add"
                        app:icon="@drawable/ub_ic_add" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Saved zones ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ub_zone_section_saved"
                    android:textAppearance="@style/Ns.Text.Overline" />

                <TextView
                    android:id="@+id/zoneCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Ns.Text.Caption"
                    tools:text="2 zones" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/zonesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="2"
                tools:listitem="@layout/geofence_item_card" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/zonesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ub_rounded_16"
                android:backgroundTint="@color/ns_surface"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    style="@style/Ns.IconBadge"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:backgroundTint="@color/ns_safe_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ub_ic_home"
                    app:tint="@color/ns_safe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ub_zone_empty_title"
                    android:textAppearance="@style/Ns.Text.Subtitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/ub_zone_empty_body"
                    android:textAppearance="@style/Ns.Text.Caption" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
