<?xml version="1.0" encoding="utf-8"?>
<!-- One guardian / ward row inside a Ns.Card list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ns_card_padding"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/clPersonInitials"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ns_icon_badge"
        android:backgroundTint="@color/ns_violet_container"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/Ns.Text.Label"
        android:textColor="@color/ns_violet" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clPersonName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Ns.Text.Subtitle" />

        <TextView
            android:id="@+id/clPersonCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Ns.Text.Caption" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clPersonRemove"
        style="@style/Ns.Button.Icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:icon="@drawable/cl_ic_close"
        app:iconSize="20dp"
        app:iconTint="@color/ns_text_muted" />
</LinearLayout>
