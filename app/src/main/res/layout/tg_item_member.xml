<?xml version="1.0" encoding="utf-8"?>
<!-- Family circle row: who, what she is to the user, when she was last seen. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Ns.Card.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ns_card_padding"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/icon"
            style="@style/Ns.IconBadge"
            android:importantForAccessibility="no"
            android:src="@drawable/ua_ic_person" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Ns.Text.Subtitle"
                tools:text="Mum" />

            <TextView
                android:id="@+id/relation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Ns.Text.Caption"
                tools:text="Your guardian" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Ns.Text.Caption"
                android:textColor="@color/ns_text_muted"
                tools:text="5 min. ago · battery 64%" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigateButton"
            style="@style/Ns.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/tg_ci_navigate"
            app:icon="@drawable/ua_ic_near_me" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
