<?xml version="1.0" encoding="utf-8"?>
<!-- One incident: summary, expandable evidence list and actions. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Ns.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Summary (tap to expand) -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="@dimen/ns_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/badge"
                    style="@style/Ns.IconBadge"
                    android:backgroundTint="@color/ns_rose_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ua_ic_shield"
                    app:tint="@color/ns_rose" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Ns.Text.Subtitle"
                        tools:text="Mon, 28 Sep 2026 · 21:41" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text_muted"
                        tools:text="Voice trigger · 12 min" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/expandIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ev_ic_expand_more"
                    app:tint="@color/ns_text_muted" />
            </LinearLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:alignItems="center"
                app:flexWrap="wrap">

                <TextView
                    android:id="@+id/silentChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/ns_pill"
                    android:backgroundTint="@color/ns_violet_container"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/ev_chip_silent"
                    android:textAppearance="@style/Ns.Text.Label"
                    android:textColor="@color/ns_violet"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/duressChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/ns_pill"
                    android:backgroundTint="@color/ns_danger_container"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/ev_chip_duress"
                    android:textAppearance="@style/Ns.Text.Label"
                    android:textColor="@color/ns_danger"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/counts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textAppearance="@style/Ns.Text.Caption"
                    android:textColor="@color/ns_text_muted"
                    tools:text="3 photos · 5 audio clips · 0 videos" />
            </com.google.android.flexbox.FlexboxLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/uploadDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ns_dot"
                    app:tint="@color/ns_safe" />

                <TextView
                    android:id="@+id/uploadText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/Ns.Text.Caption"
                    tools:text="5/7 uploaded · 5 verified ✓" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expanded: evidence items + actions -->
        <LinearLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ns_stroke" />

            <LinearLayout
                android:id="@+id/itemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/noItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ns_card_padding"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/ns_card_padding"
                android:paddingBottom="8dp"
                android:text="@string/ev_no_items"
                android:textAppearance="@style/Ns.Text.Caption"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ns_card_padding"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/ns_card_padding">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportButton"
                    style="@style/Ns.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ev_action_export"
                    app:icon="@drawable/ev_ic_archive"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/complaintButton"
                    style="@style/Ns.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ev_action_complaint"
                    app:icon="@drawable/ev_ic_gavel"
                    app:iconSize="18dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteButton"
                style="@style/Ns.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/ev_action_delete"
                android:textColor="@color/ns_danger"
                app:icon="@drawable/ua_ic_delete"
                app:iconSize="18dp"
                app:iconTint="@color/ns_danger" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
