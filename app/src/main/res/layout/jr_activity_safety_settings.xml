<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".journey.SafetySettingsActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/jr_back"
                app:icon="@drawable/ua_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/jr_ss_eyebrow"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jr_ss_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jr_ss_body"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- Appearance & language: reserved; wired to a picker by the app shell later. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appearanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <include
                    android:id="@+id/appearanceRow"
                    layout="@layout/ua_item_row" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Grouped toggle sections are added from code. -->
            <LinearLayout
                android:id="@+id/sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
