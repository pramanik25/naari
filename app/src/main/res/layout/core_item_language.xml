<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable language row: native name, English name, check mark when selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ns_card_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/ns_card_padding"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nativeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Ns.Text.Subtitle"
            tools:text="हिन्दी" />

        <TextView
            android:id="@+id/englishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Ns.Text.Caption"
            tools:text="Hindi" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ua_ic_check"
        app:tint="@color/ns_rose" />
</LinearLayout>
