<?xml version="1.0" encoding="utf-8"?>
<!-- Maker credit: round photo with "Made by Vikash". Included on the splash and in Settings > About. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/sh_brand_photo_cd"
        android:padding="1dp"
        android:scaleType="centerCrop"
        android:src="@drawable/brand_vikash"
        app:shapeAppearanceOverlay="@style/Ns.Shape.Pill"
        app:strokeColor="@color/ns_gold_line"
        app:strokeWidth="2dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sh_made_by"
            android:textAppearance="@style/Ns.Text.Subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/sh_made_by_sub"
            android:textAppearance="@style/Ns.Text.Caption" />
    </LinearLayout>
</LinearLayout>
