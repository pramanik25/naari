<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".triggers.PanicButtonActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="40dp">

            <!-- ============ Header ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/tr_back"
                app:icon="@drawable/ub_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/tr_pb_eyebrow"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityHeading="true"
                android:text="@string/tr_pb_title"
                android:textAppearance="@style/Ns.Text.Headline"
                tools:targetApi="p" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tr_pb_desc"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- ============ Hero: paired button + connection ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                style="@style/Ns.Card.Raised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:shapeAppearance="@style/Ns.Shape.Large">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.22"
                        android:background="@drawable/ns_hero_gradient" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tr_pb_status_label"
                            android:textAppearance="@style/Ns.Text.Overline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Ns.IconBadge"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:padding="13dp"
                                android:backgroundTint="@color/ns_violet_container"
                                android:importantForAccessibility="no"
                                android:src="@drawable/tr_ic_bluetooth"
                                app:tint="@color/ns_violet" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/deviceName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/Ns.Text.Title"
                                    tools:text="iTAG" />

                                <TextView
                                    android:id="@+id/deviceAddress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/Ns.Text.Caption"
                                    tools:text="FF:FF:12:34:56:78" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/ns_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ns_dot" />

                            <TextView
                                android:id="@+id/statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:accessibilityLiveRegion="polite"
                                android:textAppearance="@style/Ns.Text.Caption"
                                android:textColor="@color/ns_text_muted"
                                tools:text="@string/tr_pb_status_connected" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/protectionHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/tr_pb_protection_hint"
                            android:textAppearance="@style/Ns.Text.Caption"
                            android:textColor="@color/ns_warn"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/forgetButton"
                            style="@style/Ns.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/tr_pb_forget"
                            android:visibility="gone"
                            app:icon="@drawable/ub_ic_delete"
                            tools:visibility="visible" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Test ============ -->
            <LinearLayout
                android:id="@+id/testSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Ns.SectionLabel"
                    android:text="@string/tr_pb_section_test" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/testCard"
                    style="@style/Ns.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/ns_card_padding">

                        <FrameLayout
                            android:layout_width="140dp"
                            android:layout_height="140dp">

                            <View
                                android:id="@+id/testRing"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0"
                                android:background="@drawable/ns_sos_ring" />

                            <FrameLayout
                                android:id="@+id/testCore"
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_gravity="center"
                                android:background="@drawable/tr_circle">

                                <ImageView
                                    android:id="@+id/testIcon"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/tr_ic_bluetooth"
                                    app:tint="@color/ns_text_muted" />
                            </FrameLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:importantForAccessibility="no"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/pressDot1"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/tr_press_dot" />

                            <View
                                android:id="@+id/pressDot2"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/tr_press_dot" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/testTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center"
                            android:text="@string/tr_pb_test_title"
                            android:textAppearance="@style/Ns.Text.Title" />

                        <TextView
                            android:id="@+id/testHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/tr_pb_test_hint"
                            android:textAppearance="@style/Ns.Text.Caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/testAgainButton"
                            style="@style/Ns.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/tr_pb_test_again"
                            android:visibility="gone"
                            app:icon="@drawable/ub_ic_refresh"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ============ Find ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/tr_pb_section_find" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/findCard"
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="@dimen/ns_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tr_pb_nearby"
                            android:textAppearance="@style/Ns.Text.Subtitle" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/scanProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/tr_pb_scanning"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/ns_rose"
                            app:indicatorSize="20dp"
                            app:trackThickness="2dp"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tr_pb_scan_hint"
                        android:textAppearance="@style/Ns.Text.Caption" />

                    <LinearLayout
                        android:id="@+id/deviceList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_warn"
                        android:visibility="gone"
                        tools:text="@string/tr_pb_empty"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanButton"
                        style="@style/Ns.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/tr_pb_scan"
                        app:icon="@drawable/ub_ic_search" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Supported devices ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/tr_pb_section_supported" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Ns.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ns_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Ns.IconBadge"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/ns_gold_container"
                            android:importantForAccessibility="no"
                            android:src="@drawable/tr_ic_bluetooth"
                            app:tint="@color/ns_gold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tr_pb_sup1_title"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/tr_pb_sup1_body"
                                android:textAppearance="@style/Ns.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Ns.IconBadge"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/ns_info_container"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ua_ic_battery"
                            app:tint="@color/ns_info" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tr_pb_sup2_title"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/tr_pb_sup2_body"
                                android:textAppearance="@style/Ns.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Ns.IconBadge"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/ns_safe_container"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ub_ic_shield"
                            app:tint="@color/ns_safe" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tr_pb_sup3_title"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/tr_pb_sup3_body"
                                android:textAppearance="@style/Ns.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
