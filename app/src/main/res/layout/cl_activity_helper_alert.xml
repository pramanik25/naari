<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ns_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".cloud.HelperAlertActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ns_gutter"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/ns_gutter"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ns_pill"
            android:backgroundTint="@color/ns_rose_container"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/cl_helper_eyebrow"
            android:textAppearance="@style/Ns.Text.Overline"
            android:textColor="@color/ns_rose" />

        <!-- ============ Pulsing SOS hero ============ -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false">

            <View
                android:id="@+id/clHelperRing1"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/ns_sos_ring" />

            <View
                android:id="@+id/clHelperRing2"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ns_sos_ring" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/ns_sos_core"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cl_ic_helper"
                    app:tint="@color/ns_on_rose" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/clHelperTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/cl_helper_title"
            android:textAppearance="@style/Ns.Text.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/cl_helper_subtitle"
            android:textAppearance="@style/Ns.Text.Body" />

        <TextView
            android:id="@+id/clHelperMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textAppearance="@style/Ns.Text.Body"
            android:textColor="@color/ns_text"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cl_ic_location"
                app:tint="@color/ns_rose" />

            <TextView
                android:id="@+id/clHelperDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="@style/Ns.Text.Title"
                android:textColor="@color/ns_rose" />
        </LinearLayout>

        <!-- ============ Radius + evidence (v1.1) ============ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nbHelperRadius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ns_pill"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/Ns.Text.Label"
                android:textColor="@color/ns_text_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nbHelperEvidenceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ns_pill"
                android:backgroundTint="@color/ns_gold_container"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/Ns.Text.Label"
                android:textColor="@color/ns_gold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ Her point ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/clHelperMapCard"
            style="@style/Ns.Card"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="20dp">

            <org.osmdroid.views.MapView
                android:id="@+id/clHelperMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cl_helper_map_desc" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Latest verified photo (v1.1) ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nbHelperPhotoCard"
            style="@style/Ns.Card"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/nbHelperPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ns_surface_high"
                android:contentDescription="@string/nb_photo_desc"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nbHelperViewLive"
            style="@style/Ns.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nb_view_live"
            android:visibility="gone"
            app:icon="@drawable/cl_ic_location"
            app:iconGravity="textStart" />

        <!-- ============ Safety first ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Ns.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/ns_warn_container"
            app:strokeColor="@color/ns_warn">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cl_ic_warning"
                    app:tint="@color/ns_warn" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cl_helper_safety"
                        android:textAppearance="@style/Ns.Text.Subtitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/cl_helper_safety_detail"
                        android:textAppearance="@style/Ns.Text.Caption"
                        android:textColor="@color/ns_text_muted" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/clHelperStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="@style/Ns.Text.Body"
            android:textColor="@color/ns_text"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- ============ Actions ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clHelperGoing"
            style="@style/Ns.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cl_helper_going"
            app:icon="@drawable/cl_ic_navigation"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clHelperCall"
            style="@style/Ns.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cl_helper_call"
            app:icon="@drawable/cl_ic_call"
            app:iconGravity="textStart"
            app:iconTint="@color/ns_rose" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clHelperDismiss"
            style="@style/Ns.Button.Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/cl_helper_dismiss" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
