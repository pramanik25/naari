<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_bg_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".journey.MeetingModeActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ns_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/ns_gutter"
            android:paddingBottom="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Ns.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/jr_back"
                app:icon="@drawable/ua_ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/jr_meet_eyebrow"
                android:textAppearance="@style/Ns.Text.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jr_meet_title"
                android:textAppearance="@style/Ns.Text.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jr_meet_body"
                android:textAppearance="@style/Ns.Text.Body" />

            <!-- ============ Who ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/jr_meet_section_who" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ns_card_padding">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameLayout"
                        style="@style/Ns.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/jr_meet_name_hint"
                        app:startIconDrawable="@drawable/ua_ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="50"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contactLayout"
                        style="@style/Ns.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/jr_meet_contact_hint"
                        app:startIconDrawable="@drawable/ub_ic_link">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/contactInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLength="200"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/photoView"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@color/ns_surface_highest"
                            android:contentDescription="@string/jr_meet_photo_cd"
                            android:padding="22dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ua_ic_person"
                            app:shapeAppearanceOverlay="@style/Ns.Shape.Medium"
                            app:tint="@color/ns_text_faint" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/jr_meet_photo_title"
                                android:textAppearance="@style/Ns.Text.Subtitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/jr_meet_photo_caption"
                                android:textAppearance="@style/Ns.Text.Caption" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="-12dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/cameraButton"
                                    style="@style/Ns.Button.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:text="@string/jr_meet_camera"
                                    app:icon="@drawable/ua_ic_camera" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/galleryButton"
                                    style="@style/Ns.Button.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:text="@string/jr_meet_gallery"
                                    app:icon="@drawable/ua_ic_photo_library" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Where ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/jr_meet_section_where" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:shapeAppearance="@style/Ns.Shape.Large">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/jr_meet_map_cd" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/ns_pill"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/jr_meet_map_hint"
                        android:textAppearance="@style/Ns.Text.Label"
                        android:textColor="@color/ns_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hereButton"
                        style="@style/Ns.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:contentDescription="@string/jr_meet_use_here"
                        app:icon="@drawable/ub_ic_my_location" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/placeLayout"
                style="@style/Ns.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/jr_meet_place_hint"
                app:startIconDrawable="@drawable/ua_ic_location">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/placeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="100"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ Until ============ -->
            <TextView
                style="@style/Ns.SectionLabel"
                android:text="@string/jr_meet_section_until" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/endCard"
                style="@style/Ns.Card.Tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ns_card_padding">

                    <ImageView
                        style="@style/Ns.IconBadge"
                        android:backgroundTint="@color/ns_gold_container"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ua_ic_schedule"
                        app:tint="@color/ns_gold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/endText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Ns.Text.Title"
                            tools:text="Ends at 21:30" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/jr_meet_end_caption"
                            android:textAppearance="@style/Ns.Text.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ua_ic_chevron_right"
                        app:tint="@color/ns_text_faint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/contactsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/Ns.Text.Caption"
                tools:text="Your 3 contacts get a summary by SMS, then a check-in starts." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                style="@style/Ns.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/jr_meet_start"
                app:icon="@drawable/ua_ic_shield" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
