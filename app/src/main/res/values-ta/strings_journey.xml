    <!-- ============ Safety settings ============ -->
    <string name="jr_ss_eyebrow">பாதுகாப்பு அமைப்புகள்</string>
    <string name="jr_ss_title">உங்கள் SOS எப்படிச் செயல்படும்</string>
    <string name="jr_ss_body">மாற்றங்கள் உடனே சேமிக்கப்படும். அனுமதி தேவைப்படும் அம்சங்கள், அவற்றை இயக்கும்போது அனுமதி கேட்கும்.</string>
    <string name="jr_ss_appearance">தோற்றம் &amp; மொழி</string>
    <string name="jr_ss_appearance_sub">தீம், ஆப்ஸ் மொழி</string>

    <string name="jr_ss_section_sos">SOS செயல்பாடு</string>
    <string name="jr_ss_silent">அமைதியான SOS</string>
    <string name="jr_ss_silent_sub">சைரன், திரை, டார்ச் இல்லை. தொடர்புகளுக்குத் தெரிவிக்கப்படும், ஆதாரம் அமைதியாகப் பதிவாகும்.</string>
    <string name="jr_ss_strobe">டார்ச் மின்னல்</string>
    <string name="jr_ss_strobe_sub">சத்தமான SOS-இன்போது கவனம் ஈர்க்க டார்ச்சை மின்னச் செய்யும்.</string>
    <string name="jr_ss_speak">குரல் எச்சரிக்கை</string>
    <string name="jr_ss_speak_sub">சைரன் ஒலிகளுக்கு இடையே \"உதவி! போலீஸைக் கூப்பிடுங்கள்\" என்று சத்தமாகச் சொல்லும்.</string>
    <string name="jr_ss_escalation">அடுத்த தொடர்பை அழை</string>
    <string name="jr_ss_escalation_sub">ஒரு தொடர்பு எடுக்கவில்லை என்றால், அடுத்தவரை அழைக்கும். ஃபோன் அணுகல் தேவை.</string>
    <string name="jr_ss_112">கடைசியாக 112-ஐ அழை</string>
    <string name="jr_ss_112_sub">எல்லாத் தொடர்புகளையும் முயன்ற பிறகு, அவசரச் சேவைகளை அழைக்கும்.</string>
    <string name="jr_ss_112_confirm_title">112-ஐத் தானாக அழைக்கவா?</string>
    <string name="jr_ss_112_confirm_body">தவறான அலாரமும் அவசரச் சேவைகளை அழைக்கும் என்பதை ஏற்றுக்கொண்டால் மட்டுமே இயக்கவும்.</string>

    <string name="jr_ss_section_evidence">ஆதாரம்</string>
    <string name="jr_ss_audio">ஆடியோ பதிவு</string>
    <string name="jr_ss_audio_sub">SOS-இன்போது ஒலியைச் சிறு பகுதிகளாகப் பதிவுசெய்து ஒவ்வொன்றையும் பதிவேற்றும்.</string>
    <string name="jr_ss_video">வீடியோ பதிவு</string>
    <string name="jr_ss_video_sub">புகைப்படங்களுக்குப் பதிலாக வீடியோ. அதிக பேட்டரியும் டேட்டாவும் செலவாகும்.</string>
    <string name="jr_ss_video_confirm_title">SOS-இன்போது வீடியோ பதிவுசெய்யவா?</string>
    <string name="jr_ss_video_confirm_body">வீடியோ பேட்டரியை வேகமாகக் குறைக்கும், அதிக மொபைல் டேட்டாவைப் பயன்படுத்தும். பொதுவாகப் புகைப்படங்களும் ஆடியோவுமே போதும்.</string>
    <string name="jr_ss_mobile">மொபைல் டேட்டாவில் பதிவேற்று</string>
    <string name="jr_ss_mobile_sub">Wi-Fi-இல் மட்டுமல்ல, ஆதாரங்களை உடனே அனுப்பும்.</string>

    <string name="jr_ss_section_triggers">தானியங்கி தூண்டிகள்</string>
    <string name="jr_ss_scream">அலறல் கண்டறிதல்</string>
    <string name="jr_ss_scream_sub">ஃபோனிலேயே அலறலைக் கவனிக்கும். ஆடியோ ஒருபோதும் சேமிக்கப்படாது, அனுப்பப்படாது.</string>
    <string name="jr_ss_fall">விழுதல் கண்டறிதல்</string>
    <string name="jr_ss_fall_sub">பாதுகாப்பு இயக்கத்தில் இருக்கும்போது கடுமையாக விழுந்தால் அல்லது போராட்டம் நடந்தால் SOS தொடங்கும்.</string>
    <string name="jr_ss_headset">ஹெட்செட் பொத்தான்</string>
    <string name="jr_ss_headset_sub">வயர் அல்லது Bluetooth ஹெட்செட் பொத்தானை மூன்று முறை அழுத்தவும்.</string>
    <string name="jr_ss_volume">ஒலியளவுப் பொத்தான்கள், திரை அணைந்தபோது</string>
    <string name="jr_ss_volume_sub">ஃபோன் பூட்டியிருந்தாலும் ஒலியளவுப் பொத்தான்களால் SOS தொடங்கலாம்.</string>
    <string name="jr_ss_enable">இயக்கு</string>
    <string name="jr_ss_accessibility_on">அணுகல்தன்மைச் சேவை இயக்கத்தில் உள்ளது</string>
    <string name="jr_ss_accessibility_off">அணுகல்தன்மைச் சேவை முடக்கத்தில் உள்ளது</string>
    <string name="jr_ss_accessibility_title">அணுகல்தன்மைச் சேவையை இயக்கவும்</string>
    <string name="jr_ss_accessibility_body">திரை அணைந்திருக்கும்போது ஒலியளவுப் பொத்தான் அழுத்தங்களை ஆப்ஸ் அறிய, Android அணுகல்தன்மைச் சேவை மூலம் மட்டுமே அனுமதிக்கிறது. Naari Shakti இதைப் பொத்தான் அழுத்தங்களுக்கு மட்டுமே பயன்படுத்தும், உங்கள் திரையை ஒருபோதும் படிக்காது. பட்டியலில் Naari Shakti-ஐக் கண்டறிந்து இயக்கவும்.</string>
    <string name="jr_ss_denied_accessibility">அணுகல்தன்மைச் சேவை இல்லாமல், திரை அணைந்திருக்கும்போது ஒலியளவுப் பொத்தான்களால் SOS தொடங்க முடியாது; எனவே இது முடக்கப்பட்டது.</string>
    <string name="jr_ss_panic">பேனிக் பொத்தான்</string>
    <string name="jr_ss_panic_none">இணைக்கவில்லை · சிறிய Bluetooth பொத்தானை இணைக்கவும்</string>
