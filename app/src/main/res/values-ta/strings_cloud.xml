    <string name="cl_section_helper">அருகிலுள்ள உதவியாளர்</string>
    <string name="cl_helper_switch_title">அருகிலுள்ள உதவியாளராகச் சேருங்கள்</string>
    <string name="cl_helper_switch_caption">2 கி.மீ.க்குள் ஒருவருக்கு உதவி தேவைப்படும்போது எச்சரிக்கை பெறுங்கள். பாதுகாப்பு இயக்கத்தில் இருக்கும்போது அல்லது ஆப்ஸ் திறந்திருக்கும்போது வேலை செய்யும்.</string>
    <string name="cl_helper_dialog_title">அருகிலுள்ள உதவியாளர் ஆகவா?</string>
    <string name="cl_helper_dialog_msg">2 கி.மீ.க்குள் ஒருவர் SOS அனுப்பும்போது உங்களுக்கு எச்சரிக்கை வரும். உங்கள் இருப்பிடம் பொருத்துவதற்கு மட்டுமே பயன்படும், பிறருக்கு ஒருபோதும் காட்டப்படாது.</string>
    <string name="cl_helper_dialog_ok">இயக்கு</string>
    <string name="cl_helper_perm_denied">அருகிலுள்ளவர்களுடன் உங்களைப் பொருத்த இருப்பிட அனுமதி தேவை.</string>
    <string name="cl_helper_enabled">நீங்கள் இப்போது அருகிலுள்ள உதவியாளர்.</string>
    <string name="cl_helper_saved_offline">சேமிக்கப்பட்டது. மீண்டும் ஆன்லைனில் வரும்போது உங்கள் இருப்பிடம் ஒத்திசைக்கப்படும்.</string>

    <string name="cl_section_delete">என் கிளவுட் தரவை நீக்கு</string>
    <string name="cl_delete_caption">உங்கள் கணக்கு, சம்பவங்கள், ஆதாரங்கள், பாதுகாவலர் இணைப்புகளை சர்வரிலிருந்து நீக்கும். இந்த ஃபோனிலிருந்து அனுப்பும் எச்சரிக்கைகள் (SMS, அழைப்புகள்) தொடர்ந்து வேலை செய்யும்.</string>
