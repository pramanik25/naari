<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================== Notification channels ===================== -->
    <string name="cl_channel_guardian">பாதுகாவலர் எச்சரிக்கைகள்</string>
    <string name="cl_channel_guardian_desc">நீங்கள் பாதுகாக்கும் நபர்களிடமிருந்து வரும் SOS எச்சரிக்கைகள். அலாரம் போல ஒலிக்கும்.</string>
    <string name="cl_channel_helper">அருகிலுள்ள உதவியாளர் எச்சரிக்கைகள்</string>
    <string name="cl_channel_helper_desc">2 கி.மீ.க்குள் ஒருவருக்கு உதவி தேவை. நீங்கள் அருகிலுள்ள உதவியாளராகப் பதிவுசெய்திருந்தால் மட்டும்.</string>
    <string name="cl_channel_cloud">கிளவுட் அறிவிப்புகள்</string>
    <string name="cl_channel_cloud_desc">வழியில் வரும் உதவியாளர்கள், முடிந்த SOS, முந்தைய எச்சரிக்கைகள்.</string>

    <!-- ===================== Notifications ===================== -->
    <string name="cl_n_someone">நீங்கள் பாதுகாக்கும் ஒருவர்</string>
    <string name="cl_n_sos_title">%1$s-க்கு உதவி தேவை</string>
    <string name="cl_n_sos_text">SOS அனுப்பப்பட்டது. அவரது நேரலை இருப்பிடத்தைப் பார்க்கத் தட்டவும்.</string>
    <string name="cl_n_duress_title">%1$s இன்னும் ஆபத்தில் இருக்கலாம்</string>
    <string name="cl_n_duress_text">அவர் SOS-ஐ ரத்துசெய்ய வற்புறுத்தப்பட்டிருக்கலாம். அவரது நேரலை இருப்பிடத்தைத் தொடர்ந்து கவனியுங்கள்.</string>
    <string name="cl_n_overdue_title">%1$s செக்-இன் செய்யவில்லை</string>
    <string name="cl_n_overdue_text">அவர் பாதுகாப்பாக இருப்பதை நேரத்துக்குள் உறுதிசெய்யவில்லை. கடைசி இருப்பிடத்தைப் பார்க்கத் தட்டவும்.</string>
    <string name="cl_n_overdue_text_note">“%1$s”: அவர் பாதுகாப்பாக இருப்பதை நேரத்துக்குள் உறுதிசெய்யவில்லை. கடைசி இருப்பிடத்தைப் பார்க்கத் தட்டவும்.</string>
    <string name="cl_n_ended_title">%1$s இப்போது பாதுகாப்பாக உள்ளார்</string>
    <string name="cl_n_ended_text">SOS முடிந்தது.</string>
    <string name="cl_n_responder_title">அருகிலுள்ள உதவியாளர் வருகிறார்</string>
    <string name="cl_n_responder_text">%1$s, %2$s தொலைவில் உள்ளார்.</string>
    <string name="cl_n_responder_text_nodist">%1$s வந்துகொண்டிருக்கிறார்.</string>
    <string name="cl_n_responder_someone">ஒரு தன்னார்வலர்</string>
    <string name="cl_n_helper_title">அருகில் ஒருவருக்கு உதவி தேவை</string>
    <string name="cl_n_helper_text">உங்களிடமிருந்து %1$s. பதிலளிக்கத் தட்டவும். முதலில் 112-ஐ அழைக்கவும்.</string>
    <string name="cl_n_helper_text_nodist">உங்களுக்கு அருகில். பதிலளிக்கத் தட்டவும். முதலில் 112-ஐ அழைக்கவும்.</string>
    <string name="cl_n_earlier">முந்தைய எச்சரிக்கை</string>
    <string name="cl_action_open_tracking">நேரலை கண்காணிப்பைத் திற</string>
    <string name="cl_action_respond">பதிலளி</string>

