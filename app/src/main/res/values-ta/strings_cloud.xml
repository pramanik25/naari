    <!-- ===================== Helper alert screen ===================== -->
    <string name="cl_helper_eyebrow">அருகில் SOS</string>
    <string name="cl_helper_title">அருகில் ஒருவருக்கு உதவி தேவை</string>
    <string name="cl_helper_subtitle">உங்களுக்கு அருகிலுள்ள ஒரு Naari Shakti பயனர் SOS அனுப்பியுள்ளார்.</string>
    <string name="cl_helper_distance_unknown">உங்களுக்கு அருகில்</string>
    <string name="cl_helper_safety">உங்களை ஆபத்தில் சிக்கவைக்காதீர்கள். முதலில் 112-ஐ அழைக்கவும்.</string>
    <string name="cl_helper_safety_detail">பொதுமக்கள் பார்வையில் இருங்கள், ஃபோனை உடன் வைத்திருங்கள், காவல்துறை வழிநடத்தட்டும்.</string>
    <string name="cl_helper_going">நான் போகிறேன்</string>
    <string name="cl_helper_call">112-ஐ அழை</string>
    <string name="cl_helper_dismiss">நிராகரி</string>
    <string name="cl_helper_sending">நீங்கள் வருவதை அவருக்குத் தெரிவிக்கிறது…</string>
    <string name="cl_helper_sent">நீங்கள் வருவது அவருக்கும் அவரது பாதுகாவலர்களுக்கும் தெரியும்.</string>
    <string name="cl_helper_send_failed">சர்வரை அணுக முடியவில்லை. வழிகாட்டுதல் தொடர்கிறது.</string>
    <string name="cl_helper_no_location">உங்கள் இருப்பிடம் கிடைக்கவில்லை. வழிகாட்டுதல் தொடர்கிறது.</string>
    <string name="cl_helper_ended_title">அவர் இப்போது பாதுகாப்பாக உள்ளார்</string>
    <string name="cl_helper_ended">அவர் பாதுகாப்பாக இருப்பதாகக் குறிக்கப்பட்டது. உதவத் தயாராக இருந்ததற்கு நன்றி.</string>
    <string name="cl_helper_map_desc">உதவி தேவைப்படும் இடத்தைக் காட்டும் வரைபடம்</string>
    <string name="cl_helper_her_location">இங்கே உதவி தேவை</string>
    <string name="cl_no_app">இதைத் திறக்க இந்த ஃபோனில் ஆப்ஸ் இல்லை.</string>

    <!-- ===================== Cloud & guardians screen ===================== -->
    <string name="cl_back">பின்செல்</string>
    <string name="cl_settings_eyebrow">கிளவுட்</string>
    <string name="cl_settings_title">கிளவுட் &amp; பாதுகாவலர்கள்</string>
    <string name="cl_settings_desc">SMS சென்றடையாவிட்டாலும், உங்கள் SOS நேரலை இருப்பிடம் மற்றும் ஆதாரங்களுடன் பாதுகாவலர்களுக்கு உடனே சேரும்.</string>

    <string name="cl_error_offline">நீங்கள் ஆஃப்லைனில் உள்ளீர்கள். இந்த ஃபோனில் சேமித்தவை காட்டப்படுகின்றன.</string>
    <string name="cl_error_server">Naari Shakti சர்வரை அணுக முடியவில்லை.</string>
    <string name="cl_error_generic">ஏதோ தவறு நடந்தது (பிழை %1$d). மீண்டும் முயலவும்.</string>
    <string name="cl_retry">மீண்டும் முயல்</string>

    <string name="cl_off_title">கிளவுட் ஒத்திசைவு முடக்கத்தில் உள்ளது</string>
    <string name="cl_off_caption_unconfigured">இந்த ஆப்ஸ் பதிப்பில் சர்வர் அமைக்கப்படவில்லை, எனவே பாதுகாவலர்கள், நேரலை கண்காணிப்பு, அருகிலுள்ள உதவியாளர்கள் கிடைக்காது. SMS எச்சரிக்கைகள் வழக்கம்போல் வேலை செய்யும்.</string>
    <string name="cl_off_caption_deleted">உங்கள் கிளவுட் தரவை நீக்கிவிட்டீர்கள். பாதுகாவலர்களுடன் மீண்டும் SOS பகிர கிளவுட் ஒத்திசைவை இயக்கவும்.</string>
    <string name="cl_enable_cloud">கிளவுட் ஒத்திசைவை மீண்டும் இயக்கு</string>

