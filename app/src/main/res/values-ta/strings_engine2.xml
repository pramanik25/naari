    <!-- SMS -->
    <string name="en_sms_tracking_line">நேரலை இருப்பிடம் &amp; ஆதாரம்: %1$s</string>
    <string name="en_sms_duress">Naari Kavach: %1$s எச்சரிக்கையை ரத்துசெய்ய வற்புறுத்தப்பட்டிருக்கலாம். இது இன்னும் செயலில் உள்ளதாகக் கருதுங்கள். நேரலை இருப்பிடம்: %2$s</string>
    <string name="en_sms_duress_no_link">Naari Kavach: %1$s எச்சரிக்கையை ரத்துசெய்ய வற்புறுத்தப்பட்டிருக்கலாம். இது இன்னும் செயலில் உள்ளதாகக் கருதுங்கள். இருப்பிடம் பின்னர் வரும்.</string>
    <string name="en_duress_name_fallback">உங்கள் தொடர்பு</string>

