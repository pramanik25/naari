    <!-- ===================== Onboarding ===================== -->
    <string name="onb_overline">தொடங்கும் முன்</string>
    <string name="onb_title">உங்கள் பாதுகாப்பு வலையை அமைப்போம்</string>
    <string name="onb_body">உங்களைப் பாதுகாக்க Naari Kavach-க்குச் சில அனுமதிகள் தேவை. கட்டுப்பாடு உங்களிடமே இருக்கும்; அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றலாம்.</string>
    <string name="onb_allow">அனுமதி வழங்கு</string>
    <string name="onb_done">எல்லாம் தயார். நீங்கள் தயாரானதும் பாதுகாப்பை இயக்கவும்.</string>
    <string name="onb_partial">சில அனுமதிகள் தவிர்க்கப்பட்டன. அவற்றை அமைப்புகளில் வழங்கலாம்.</string>
    <string name="perm_mic_title">மைக்ரோஃபோன்</string>
    <string name="perm_mic_why">திரை அணைந்திருந்தாலும் உங்கள் அவசரச் சொல்லைக் கேட்க</string>
    <string name="perm_sms_title">SMS</string>
    <string name="perm_sms_why">உங்கள் நேரலை இருப்பிடத்தைத் தொடர்புகளுக்கு SMS அனுப்ப</string>
    <string name="perm_phone_title">ஃபோன்</string>
    <string name="perm_phone_why">உங்கள் முதல் தொடர்பைத் தானாக அழைக்க</string>
    <string name="perm_location_title">இருப்பிடம்</string>
    <string name="perm_location_why">SOS-இன்போது நீங்கள் இருக்கும் இடத்தைத் துல்லியமாகப் பகிர</string>
    <string name="perm_camera_title">கேமரா</string>
    <string name="perm_camera_why">SOS-இன்போது அமைதியாக ஆதாரங்களைப் பதிவுசெய்ய</string>
    <string name="perm_contacts_title">தொடர்புகள்</string>
    <string name="perm_contacts_why">உங்கள் ஃபோனிலிருந்து அவசரத் தொடர்புகளைத் தேர்வுசெய்ய</string>
    <string name="perm_notifications_title">அறிவிப்புகள்</string>
    <string name="perm_notifications_why">பாதுகாப்பு இயங்குவதைக் காட்ட</string>
    <string name="perm_battery_title">பேட்டரி மேம்படுத்தல்</string>
    <string name="perm_battery_why">பின்னணியில் பாதுகாப்பைத் தொடர்ந்து இயங்கவைக்க</string>
    <string name="perm_fullscreen_title">முழுத்திரை எச்சரிக்கைகள்</string>
    <string name="perm_fullscreen_why">பூட்டுத் திரையின் மேல் SOS திரையைக் காட்ட</string>
    <string name="perm_exact_alarm_title">துல்லியமான அலாரங்கள்</string>
    <string name="perm_exact_alarm_why">திட்டமிட்ட பாதுகாப்பைச் சரியான நேரத்தில் தொடங்க</string>
    <string name="perm_overlay_title">பிற ஆப்ஸின் மேல் காட்டு</string>
    <string name="perm_overlay_why">பிற ஆப்ஸின் மேல் SOS பூட்டுத் திரையைக் காட்ட</string>
    <string name="perm_denied_title">அனுமதி தேவை</string>
    <string name="perm_denied_body">%1$s அணுகல் முடக்கப்பட்டுள்ளது. ஆப்ஸ் அமைப்புகள் பக்கத்தில் அதை அனுமதிக்கலாம்.</string>
    <string name="perm_summary">%2$d-இல் %1$d தயார்</string>

