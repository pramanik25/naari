<resources>

    <!-- Notification channels -->
    <string name="eng_channel_protection">பாதுகாப்பு நிலை</string>
    <string name="eng_channel_protection_desc">உங்கள் அவசரச் சொல், குலுக்கல், பவர் பொத்தான் அழுத்தங்களை Naari Kavach கவனிக்கும்போது காட்டப்படும்.</string>
    <string name="eng_channel_sos">SOS எச்சரிக்கைகள்</string>
    <string name="eng_channel_sos_desc">SOS கவுண்ட்டவுன் அல்லது செயலில் இருக்கும்போது முழுத்திரை எச்சரிக்கை.</string>
    <string name="eng_channel_alerts">பாதுகாப்பு எச்சரிக்கைகள்</string>
    <string name="eng_channel_alerts_desc">மறுதொடக்கத்துக்குப் பின் பாதுகாப்பை மீண்டும் இயக்குவது போன்ற கவனம் தேவைப்படும் நினைவூட்டல்கள்.</string>
    <string name="eng_channel_live">நேரலை இருப்பிடப் பகிர்வு</string>
    <string name="eng_channel_live_desc">உங்கள் நேரலை இருப்பிடம் தொடர்புகளுடன் பகிரப்படும்போது காட்டப்படும்.</string>
    <string name="eng_channel_geofence">சேமித்த இடங்கள்</string>
    <string name="eng_channel_geofence_desc">சேமித்த இடத்துக்கு வரும்போது அல்லது அங்கிருந்து செல்லும்போது எச்சரிக்கை.</string>

    <!-- Protection notification -->
    <string name="eng_protect_title">Naari Kavach உங்களைப் பாதுகாக்கிறது</string>
    <string name="eng_protect_text">“%1$s” கேட்கிறது · SOS-க்கு பவர் ×%2$d</string>
    <string name="eng_protect_text_no_voice">SOS-க்குக் குலுக்கவும் அல்லது பவர் ×%1$d</string>
    <string name="eng_action_sos_now">உடனே SOS</string>
    <string name="eng_action_turn_off">நிறுத்து</string>

    <!-- Resume notification -->
    <string name="eng_resume_title">பாதுகாப்பை மீண்டும் தொடங்கத் தட்டவும்</string>
    <string name="eng_resume_text">மறுதொடக்கத்துக்குப் பின் Android, Naari Kavach-ஐ இடைநிறுத்தியது. பாதுகாப்பை மீண்டும் இயக்க ஆப்ஸைத் திறக்கவும்.</string>

    <!-- SOS notification -->
    <string name="eng_sos_countdown_title">SOS அனுப்புகிறது…</string>
    <string name="eng_sos_countdown_text">உங்கள் தொடர்புகளுக்குத் தெரிவிக்கப்படும். தவறுதலாக என்றால் ரத்துசெய் என்பதைத் தட்டவும்.</string>
    <string name="eng_sos_active_title">SOS செயலில்</string>
    <string name="eng_sos_active_text">தொடர்புகளுக்குத் தெரிவித்து, நேரலை இருப்பிடத்தைப் பகிர்கிறது.</string>
    <string name="eng_action_cancel">ரத்துசெய்</string>
    <string name="eng_action_stop_sos">SOS-ஐ நிறுத்து</string>
