    <string name="jr_ss_section_sos">SOS कैसे काम करे</string>
    <string name="jr_ss_silent">साइलेंट SOS</string>
    <string name="jr_ss_silent_sub">न सायरन, न स्क्रीन, न टॉर्च। कॉन्टैक्ट्स को अलर्ट जाता है और सबूत चुपचाप रिकॉर्ड होते हैं।</string>
