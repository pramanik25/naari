    <string name="jr_ss_shutdown">फोन बंद झाला</string>
    <string name="jr_ss_shutdown_sub">संरक्षण चालू असताना फोन बंद झाल्यास तुमचे शेवटचे लोकेशन SMS करा.</string>
    <string name="jr_ss_battery">बॅटरी जवळपास संपली</string>
    <string name="jr_ss_battery_sub" formatted="false">बॅटरी 5% राहिल्यावर तुमचे शेवटचे लोकेशन SMS करा.</string>
    <string name="jr_ss_sim">SIM कार्ड बदलले</string>
    <string name="jr_ss_sim_sub">कोणी SIM बदलल्यास तुमच्या कॉन्टॅक्टना अलर्ट करा. फोनची परवानगी लागते.</string>

