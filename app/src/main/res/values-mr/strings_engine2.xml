    <!-- Silent SOS: low-key notification and covert screen -->
    <string name="en_covert_title">Naari Shakti · लोकेशन शेअर होत आहे</string>
    <string name="en_covert_text">व्यवस्थापित करण्यासाठी टॅप करा</string>
    <string name="en_covert_overline">Naari Shakti</string>
    <string name="en_covert_heading">तुमचे लोकेशन शेअर होत आहे</string>
    <string name="en_covert_body">तुमच्या विश्वासातील कॉन्टॅक्टना तुमचे लाइव्ह लोकेशन मिळत आहे.</string>
    <string name="en_covert_hold">शेअरिंग थांबवण्यासाठी दाबून ठेवा</string>
    <string name="en_covert_hint">2 सेकंद दाबून ठेवा.</string>
    <string name="en_covert_close">बंद करा</string>

