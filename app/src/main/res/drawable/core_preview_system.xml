<?xml version="1.0" encoding="utf-8"?>
<!-- Half light / half dark miniature for "Follow phone" (fixed colours by design). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFAF8F4" />
            <stroke android:width="1dp" android:color="#FFE8E0D0" />
        </shape>
    </item>
    <item android:width="44dp" android:gravity="end|fill_vertical">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="14dp" android:bottomRightRadius="14dp" />
            <solid android:color="#FF0B0A10" />
        </shape>
    </item>
    <item android:width="30dp" android:height="30dp" android:gravity="bottom|center_horizontal" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFFF4D7E" />
            <stroke android:width="1dp" android:color="#FFF3D49A" />
        </shape>
    </item>
</layer-list>
