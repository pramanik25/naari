<?xml version="1.0" encoding="utf-8"?>
<!-- Floating "dock" surface behind the bottom navigation: fully rounded, hairline edge.
     Paired with a real elevation value on the view for a soft cast shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="@color/ns_surface" />
    <stroke android:width="1dp" android:color="@color/ns_stroke" />
</shape>
