<?xml version="1.0" encoding="utf-8"?>
<!-- Hero/header panel gradient (rose -> plum -> violet), 28dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:angle="315"
        android:startColor="@color/ns_rose_deep"
        android:centerColor="#FF7A2A8C"
        android:endColor="@color/ns_violet_deep"
        android:type="linear" />
</shape>
