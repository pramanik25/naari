<?xml version="1.0" encoding="utf-8"?>
<!-- "You are here" map marker: rose core, white rim, soft rose halo. Anchor at centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <solid android:color="@color/ns_rose_glow_1" />
        </shape>
    </item>
    <item android:bottom="12dp" android:left="12dp" android:right="12dp" android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:bottom="15dp" android:left="15dp" android:right="15dp" android:top="15dp">
        <shape android:shape="oval">
            <solid android:color="@color/ns_rose" />
        </shape>
    </item>
</layer-list>
