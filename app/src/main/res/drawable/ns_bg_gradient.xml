<?xml version="1.0" encoding="utf-8"?>
<!-- Screen backdrop: faint violet bloom at the top fading to near-black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ns_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="120%p"
                android:startColor="#3321184A"
                android:endColor="#000A0A12" />
        </shape>
    </item>
</layer-list>
