<?xml version="1.0" encoding="utf-8"?>
<!-- Screen backdrop: a soft bloom at the top fading into the page background.
     Colours come from the active palette (light or dark). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ns_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="120%p"
                android:startColor="@color/ns_bloom"
                android:endColor="@color/ns_bloom_end" />
        </shape>
    </item>
</layer-list>
