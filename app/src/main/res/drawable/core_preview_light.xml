<?xml version="1.0" encoding="utf-8"?>
<!-- Miniature of the light theme for the Appearance picker (fixed colours by design). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFF7F6FB" />
            <stroke android:width="1dp" android:color="#FFE3DEEE" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="12dp" android:height="18dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#FFE3DEEE" />
        </shape>
    </item>
    <item android:left="10dp" android:right="36dp" android:top="36dp" android:height="8dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#FFE9E4F4" />
        </shape>
    </item>
    <item android:width="30dp" android:height="30dp" android:gravity="bottom|center_horizontal" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFE8336B" />
        </shape>
    </item>
</layer-list>
