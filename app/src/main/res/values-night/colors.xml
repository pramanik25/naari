<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- "Onyx Rose" dark palette (premium/elite pass). Light values live in values/colors.xml. -->

    <!-- Surfaces (elevation increases downwards): a warm, near-black onyx rather than a cool
         blue-black, for a richer "boutique security" feel. -->
    <color name="ns_bg">#FF0B0A10</color>
    <color name="ns_bg_top">#FF1A1424</color>
    <color name="ns_surface">#FF141019</color>
    <color name="ns_surface_high">#FF1D1722</color>
    <color name="ns_surface_highest">#FF29222F</color>
    <color name="ns_stroke">#FF342C3D</color>
    <color name="ns_stroke_soft">#1FFFFFFF</color>
    <color name="ns_scrim">#E60B0A10</color>

    <!-- Text -->
    <color name="ns_text">#FFF7F3FA</color>
    <color name="ns_text_muted">#FFACA4BF</color>
    <color name="ns_text_faint">#FF746C88</color>

    <!-- Signature rose (SOS / primary) -->
    <color name="ns_rose">#FFFF4D7E</color>
    <color name="ns_rose_deep">#FFD81B60</color>
    <color name="ns_rose_dark">#FF8E0E3E</color>
    <color name="ns_rose_container">#33FF4D7E</color>
    <color name="ns_on_rose">#FFFFFFFF</color>

    <!-- Violet (secondary) -->
    <color name="ns_violet">#FF8B7CFF</color>
    <color name="ns_violet_deep">#FF5B4BDB</color>
    <color name="ns_violet_container">#338B7CFF</color>

    <!-- Champagne gold (premium accent, use sparingly) -->
    <color name="ns_gold">#FFE8C27A</color>
    <color name="ns_gold_container">#29E8C27A</color>
    <!-- Brighter gold for small standalone accents (medallion rims, dividers, icons). -->
    <color name="ns_gold_bright">#FFF3D49A</color>
    <!-- Hairline-strength gold, for the "elite" card border / accent divider. -->
    <color name="ns_gold_line">#40E8C27A</color>

    <!-- Semantic -->
    <color name="ns_safe">#FF3DDC97</color>
    <color name="ns_safe_container">#293DDC97</color>
    <color name="ns_warn">#FFFFB547</color>
    <color name="ns_warn_container">#29FFB547</color>
    <color name="ns_danger">#FFFF5A5F</color>
    <color name="ns_danger_container">#29FF5A5F</color>
    <color name="ns_info">#FF5EC8FF</color>
    <color name="ns_info_container">#295EC8FF</color>

    <!-- Glow / ring alphas for the SOS hero -->
    <color name="ns_rose_glow_1">#59FF4D7E</color>
    <color name="ns_rose_glow_2">#26FF4D7E</color>
    <color name="ns_rose_glow_3">#10FF4D7E</color>
    <color name="ns_safe_glow">#403DDC97</color>
    <!-- Soft bloom at the top of screen backgrounds: a deep plum-rose glow fading to onyx. -->
    <color name="ns_bloom">#402A1640</color>
    <color name="ns_bloom_end">#000B0A10</color>
    <!-- Soft ambient shadow for elevated "elite" surfaces. -->
    <color name="ns_shadow">#80000000</color>

</resources>
