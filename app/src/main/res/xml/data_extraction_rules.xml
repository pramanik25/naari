<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (Android 12+). Same exclusions as backup_rules.xml:
     Keystore-encrypted data (private diary, cloud credentials) and evidence bookkeeping. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diary/" />
        <exclude domain="file" path="cycle/" />
        <exclude domain="file" path="Evidence/" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />
        <exclude domain="sharedpref" path="ns_cloud_secure.xml" />
        <exclude domain="database" path="evidence.db" />
        <exclude domain="database" path="ns_cloud_outbox.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diary/" />
        <exclude domain="file" path="cycle/" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />
        <exclude domain="sharedpref" path="ns_cloud_secure.xml" />
        <exclude domain="database" path="ns_cloud_outbox.db" />
    </device-transfer>
</data-extraction-rules>
