<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 11 and older). Keystore-encrypted data can't be decrypted on another
     device, and evidence bookkeeping would point at files that aren't restored, so those are
     excluded. Settings, contacts and the profile are backed up. -->
<full-backup-content>
    <exclude domain="file" path="diary/" />
    <exclude domain="file" path="Evidence/" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />
    <exclude domain="sharedpref" path="ns_cloud_secure.xml" />
    <exclude domain="database" path="evidence.db" />
    <exclude domain="database" path="ns_cloud_outbox.db" />
</full-backup-content>
