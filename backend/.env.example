# Copy to .env (never commit .env). See README.md for details.

# Required: Postgres 13+ connection string (no extensions needed).
DATABASE_URL=postgres://naari@127.0.0.1:55432/naarishakti

PORT=8080

# Public origin used in tracking links sent to contacts: ${PUBLIC_BASE_URL}/t/<token>
# Must be the HTTPS URL of your reverse proxy in production.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Where evidence files are stored (back this directory up).
EVIDENCE_DIR=./data/evidence

# HMAC key for 15-minute evidence links. Set a long random value in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# If unset, a random key is generated per boot and links break on restart / across instances.
SIGNING_SECRET=

# Max bytes per evidence upload (default 50 MB).
MAX_EVIDENCE_BYTES=52428800

# Optional: SMS to check-in contacts when a check-in becomes overdue.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: WhatsApp Business Cloud API alerts to her opted-in emergency contacts.
# Dormant until WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID are both set. See README "WhatsApp alerts setup".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value into the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App secret (Meta app > Settings > Basic). Strongly recommended: without it webhook posts are not
# authenticated and anyone could forge JOIN/STOP.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
# Business number in E.164 for the wa.me JOIN link; looked up from the Graph API when empty.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TEMPLATE_SOS=naari_sos_alert
WHATSAPP_TEMPLATE_SOS_TEXT=naari_sos_alert_text
WHATSAPP_TEMPLATE_EVIDENCE=naari_sos_evidence
WHATSAPP_TEMPLATE_SAFE=naari_sos_safe
WHATSAPP_TEMPLATE_LANG=en

# true = trust one proxy hop for X-Forwarded-For (needed behind nginx/Caddy/Render/Railway
# so per-IP rate limits see the real client). Also accepts a hop count or an express trust-proxy list.
TRUST_PROXY=false

# pino log level: fatal | error | warn | info | debug | silent
LOG_LEVEL=info
