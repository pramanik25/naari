# Copy to .env.local (never commit .env.local).

# Same Postgres database the backend uses (backend/.env DATABASE_URL).
DATABASE_URL=

# Password asked on the /login page. Required — the console refuses to log in when unset.
ADMIN_PASSWORD=

# Optional: secret for signing the session cookie. Defaults to a value derived
# from ADMIN_PASSWORD; set it explicitly if you rotate the password often.
ADMIN_SESSION_SECRET=

# Public origin of the API server, used to build tracking links (…/t/<token>).
PUBLIC_BASE_URL=https://naari-84uu.onrender.com

# Timezone used to display timestamps.
ADMIN_TZ=Asia/Kolkata
